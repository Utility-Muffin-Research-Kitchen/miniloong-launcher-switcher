start_owned_loong() {
    name="$1"
    cfg="$2"
    pidfile="$3"

    pidof "$name" >/dev/null 2>&1 && {
        log_msg "$name already running; not leaf-owned"
        return 0
    }
    [ -x "/loong/$name" ] || {
        log_msg "/loong/$name missing or not executable"
        return 1
    }

    log_msg "starting leaf-owned $name"
    (
        cd /loong 2>/dev/null || exit 127
        export LD_LIBRARY_PATH="./:${LD_LIBRARY_PATH:-}"
        if [ "$name" = loong_power ] && [ -n "${UMRK_LOONG_POWER_HANDOFF_DIR:-}" ]; then
            export PATH="$UMRK_LOONG_POWER_HANDOFF_DIR:$PATH"
        fi
        # exec keeps the pidfile on the daemon itself, so shutdown can stop it
        # by PID instead of falling back to a slower name search.
        if [ -n "$cfg" ]; then
            exec "./$name" "$cfg"
        else
            exec "./$name"
        fi
    ) >>"$LOG" 2>&1 &
    echo "$!" >"$pidfile" 2>/dev/null || true
    return 0
}

# Stock loong_power's low-battery shutdown runs system("poweroff"). The BusyBox
# applet only signals PID 1, which stays blocked in rcS while Leaf owns the
# boot, so the device used to run on until the battery cut power with both
# cards writable. Resolve its poweroff/reboot to jawakad's power handoff so
# the normal cleanup and storage barrier run. If jawakad cannot be reached,
# nothing else happens, as before. Jawaka restarts loong_power after a power
# setting changes; it reads UMRK_LOONG_POWER_HANDOFF_DIR to keep this PATH.
LOONG_POWER_HANDOFF_DIR="$TMPDIR/umrk-loong-power-bin"
prepare_loong_power_handoff() {
    ctl="${UMRK_BIN_PATH:-}/jawaka-platformctl"
    sock="${JAWAKA_RUNTIME_DIR:-$RUNTIME_DIR}/jawakad.sock"
    case "$ctl$sock" in *\"*|*\\*|*\$*|*\`*) return 1 ;; esac
    [ -x "$ctl" ] || return 1
    rm -rf "$LOONG_POWER_HANDOFF_DIR" && mkdir -p "$LOONG_POWER_HANDOFF_DIR" || return 1
    cat >"$LOONG_POWER_HANDOFF_DIR/poweroff" <<EOF || return 1
#!/bin/sh
action="\${0##*/}"
# Its poweroff is the low-battery shutdown; the reason only labels the pause.
reason=menu
[ "\$action" = poweroff ] && reason=low-battery
echo "loong_power requested \$action; handing it to jawakad"
exec "$ctl" --socket "$sock" request "{\\"type\\":\\"platform-action\\",\\"action\\":\\"\$action\\",\\"value\\":0,\\"reason\\":\\"\$reason\\"}"
EOF
    chmod 755 "$LOONG_POWER_HANDOFF_DIR/poweroff" &&
        ln -sf poweroff "$LOONG_POWER_HANDOFF_DIR/reboot"
}

# stop_owned_process NAME PIDFILE [POLLS]: POLLS x 50 ms grace before SIGKILL.
stop_owned_process() {
    name="$1"
    pidfile="$2"
    polls="${3:-6}"
    [ -f "$pidfile" ] || return 0
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    rm -f "$pidfile" 2>/dev/null || true
    case "$pid" in *[!0-9]*|'') return 0 ;; esac
    [ -d "/proc/$pid" ] || return 0
    comm="$(cat "/proc/$pid/comm" 2>/dev/null || true)"
    [ "$comm" = "$name" ] || return 0
    log_msg "stopping leaf-owned $name pid=$pid"
    stop_pid "$pid" "$polls"
}

stop_remaining_processes_by_name() {
    name="$1"
    pids="$(pidof "$name" 2>/dev/null || true)"
    [ -n "$pids" ] || return 0
    log_msg "stopping remaining $name pids=$pids"
    kill $pids 2>/dev/null || true
    polls=0
    while [ "$polls" -lt 6 ] && pidof "$name" >/dev/null 2>&1; do
        sleep .05
        polls=$((polls + 1))
    done
    pids="$(pidof "$name" 2>/dev/null || true)"
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null || true
}

stop_leaf_owned_loong() {
    stop_owned_process loong_light "$OWNED_LIGHT_PID"
    stop_remaining_processes_by_name loong_light
    stop_owned_process loong_power "$OWNED_POWER_PID"
    stop_remaining_processes_by_name loong_power
}

stop_audio_spk_keeper() {
    [ -f "$AUDIO_SPK_KEEPER_PID" ] || return 0
    pid="$(cat "$AUDIO_SPK_KEEPER_PID" 2>/dev/null || true)"
    rm -f "$AUDIO_SPK_KEEPER_PID" 2>/dev/null || true
    case "$pid" in *[!0-9]*|'') return 0 ;; esac
    [ -d "/proc/$pid" ] || return 0
    log_msg "stopping audio speaker keeper pid=$pid"
    stop_pid "$pid" 4
}

stop_wifi_workers() {
    for wifi_worker in boot-worker resume-watch link-watch; do
        case "$wifi_worker" in
            boot-worker) wifi_pidfile="$TMPDIR/umrk-wifi-dhcpv4.pid" ;;
            resume-watch) wifi_pidfile="$TMPDIR/umrk-wifi-resume-watch.pid" ;;
            link-watch) wifi_pidfile="$TMPDIR/umrk-wifi-link-watch.pid" ;;
        esac
        wifi_pid="$(cat "$wifi_pidfile" 2>/dev/null || true)"
        rm -f "$wifi_pidfile" 2>/dev/null || true
        case "$wifi_pid" in ''|*[!0-9]*) continue ;; esac
        # Match the script and worker mode, not just a possibly reused PID.
        case "$(tr '\0' '\n' 2>/dev/null < "/proc/$wifi_pid/cmdline")" in
            *"/00-wifi-dhcpv4.sh
--$wifi_worker")
                log_msg "stopping Wi-Fi $wifi_worker pid=$wifi_pid"
                stop_pid "$wifi_pid" 4
                ;;
        esac
    done
}

# Ceiling for the Leaf daemon's own orderly shutdown. It must exceed the
# daemon's worst case, which is dominated by the RetroArch app tile's 9s stop
# grace plus service teardown. A measured MLP1 stop with the app tile open takes
# about 2s; this is only the bound for a wedged one.
JAWAKAD_STOP_TIMEOUT_S="${JAWAKAD_STOP_TIMEOUT_S:-15}"
# Anything still alive once the daemon has gone is a straggler, not a writer.
STRAGGLER_STOP_TIMEOUT_S="${STRAGGLER_STOP_TIMEOUT_S:-3}"

# The daemon is deployed as loong_pangu -- jawakad renamed -- so `pidof jawakad`
# finds nothing on a real device, and `pidof loong_pangu` alone cannot tell the
# Leaf daemon from the stock launcher. Confirm with the executable path: only
# the Leaf daemon lives under a Leaf platform root.
leaf_daemon_pids() {
    out=""
    for pid in $(pidof loong_pangu 2>/dev/null || true) $(pidof jawakad 2>/dev/null || true); do
        [ "$pid" = "$$" ] && continue
        # Match the DIRECTORY, not the file name. pidof already narrowed by
        # process name, which is fixed at exec time; this check exists only to
        # exclude the stock launcher, which lives at /loong or under
        # $STOCK_RUN_DIR and shares the basename. Matching an exact executable
        # path instead would miss a daemon whose binary has since moved: Leaf
        # staging does `rm -rf` on the live launcher directory, after which the
        # exe link reads ".../loong_pangu (deleted)", and a rename would leave
        # a different basename entirely. Both still resolve under the Leaf
        # platform root, which is the part that actually identifies it.
        case "$(readlink "/proc/$pid/exe" 2>/dev/null || true)" in
            */.system/leaf/*) out="$out $pid" ;;
        esac
    done
    printf '%s' "$out" | sed 's/^ //'
}

leaf_stale_pids() {
    out="$(leaf_daemon_pids)"
    # jawakad by name as well: leaf_daemon_pids covers the deployed
    # loong_pangu, but a dev build can be staged under its real name.
    # jawaka-ledd, the LED effects engine, outlives a killed daemon on Jawaka
    # releases that did not tie it to its parent. Left running it keeps the
    # session log on the card open, and the card cannot close at shutdown.
    for name in jawakad jawaka-launcher jawaka-menu jawaka-osd jawaka-ledd retroarch PPSSPPSDL; do
        pids="$(pidof "$name" 2>/dev/null || true)"
        [ -n "$pids" ] && out="$out $pids"
    done
    if command -v pgrep >/dev/null 2>&1; then
        pids="$(pgrep -f jawaka-retroarch-runner 2>/dev/null || true)"
        [ -n "$pids" ] && out="$out $pids"
    fi
    printf '%s' "$out" | tr -s ' ' | sed 's/^ //;s/ $//'
}

pids_alive() {
    out=""
    for p in "$@"; do
        [ -n "$p" ] && kill -0 "$p" 2>/dev/null && out="$out $p"
    done
    printf '%s' "$out" | sed 's/^ //'
}

# Bounded poll on a FIXED pid list. $1 = ceiling in seconds, $2.. = pids.
# The deadline is wall-clock, so the ceiling holds regardless of sleep
# granularity and no caller here can hang.
wait_pids_gone() {
    _deadline=$(( $(date +%s) + $1 ))
    shift
    while [ -n "$(pids_alive "$@")" ]; do
        [ "$(date +%s)" -ge "$_deadline" ] && return 1
        sleep .2
    done
    return 0
}

# Stop a previous Leaf generation without destroying the work it has in flight.
#
# The daemon owns an orderly shutdown: it asks the RetroArch app runner to stop,
# gives it time to quit RetroArch over the command port and copy the shared
# RetroArch config back to the SD card, and only then exits. Signalling the
# daemon, retroarch and the runner all at once and force-killing them one second
# later pre-empted exactly that. A measured MLP1 app-tile stop takes about 1.5s
# end to end, so the old SIGKILL landed in the middle of RetroArch's save or the
# copy-back that follows it, and the session's RetroArch settings were lost
# (Leaf#48). This function is what `S50leaf stop` and a Leaf-initiated restart
# run, so it was on the common path, not an edge case.
#
# Ask the daemon first and wait for it. Whatever is still alive afterwards is a
# genuine straggler -- the daemon was never running, or it failed to take its
# children with it -- and is stopped the blunt way.
kill_stale_custom_launcher() {
    # Snapshot first, and never signal anything outside it. Stopping the daemon
    # can take seconds, and a re-read after the wait can pick up the INCOMING
    # generation instead of the outgoing one.
    stale="$(leaf_stale_pids)"
    [ -n "$stale" ] || return 0

    daemons="$(leaf_daemon_pids)"
    if [ -n "$daemons" ]; then
        log_msg "stopping Leaf daemon pids=$daemons (allowing up to ${JAWAKAD_STOP_TIMEOUT_S}s to save)"
        kill $daemons 2>/dev/null || true
        if wait_pids_gone "$JAWAKAD_STOP_TIMEOUT_S" $daemons; then
            log_msg "Leaf daemon exited cleanly"
        else
            log_msg "Leaf daemon did not exit within ${JAWAKAD_STOP_TIMEOUT_S}s; forcing survivors"
        fi
    fi

    pids="$(pids_alive $stale)"
    if [ -n "$pids" ]; then
        log_msg "stopping stale launcher processes pids=$pids"
        kill $pids 2>/dev/null || true
        wait_pids_gone "$STRAGGLER_STOP_TIMEOUT_S" $pids || true
    fi

    pids="$(pids_alive $stale)"
    if [ -n "$pids" ]; then
        log_msg "force stopping stale launcher processes pids=$pids"
        kill -9 $pids 2>/dev/null || true
    fi
}

recover_leaf_daemon_crash() {
    [ ! -f "$CLEAN_EXIT_SENTINEL" ] || return 0

    log_msg "unclean Leaf daemon exit; recovering managed children and display"
    kill_stale_custom_launcher

    if ! pidof weston >/dev/null 2>&1; then
        log_msg "unclean Leaf daemon exit left Weston stopped; starting compositor"
        /etc/init.d/S49weston start >>"$LOG" 2>&1 || true
        i=0
        while [ "$i" -lt 50 ]; do
            pidof weston >/dev/null 2>&1 && break
            sleep .1
            i=$((i + 1))
        done
        if ! pidof weston >/dev/null 2>&1; then
            log_msg "unclean Leaf daemon recovery could not restart Weston"
        fi
    fi
}

