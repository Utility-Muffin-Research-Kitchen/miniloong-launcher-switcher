rootfs_restore_ro() {
    mount -o remount,ro / 2>/dev/null || true
}

count_pngs() {
    dir="$1"
    count="$(find "$dir" -maxdepth 1 -type f -name '*.png' 2>/dev/null | wc -l | tr -d ' ')"
    case "$count" in *[!0-9]*|'') count=0 ;; esac
    printf '%s\n' "$count"
}

write_stock_boot_cfg_fallback() {
    seq0="$(count_pngs "$BOOT_STOCK_DIR/0")"
    seq1="$(count_pngs "$BOOT_STOCK_DIR/1")"
    [ "$seq0" -gt 0 ] 2>/dev/null || seq0=1
    [ "$seq1" -gt 0 ] 2>/dev/null || seq1=1
    printf '{"dir":"/loong/textures/boot","bg":255,"seques":[{"num":%s,"interval":100,"wait":0,"repeat":1},{"num":%s,"interval":100,"wait":0,"repeat":-1}]}\n' \
        "$seq0" "$seq1" >/loong/textures/boot.cfg 2>/dev/null
}

restore_stock_boot_animation() {
    [ "$PLATFORM" = "mlp1" ] || return 0

    mode="$(cat "$BOOT_MODE" 2>/dev/null || true)"
    if [ "$mode" = "stock" ] && [ -d "$BOOT_STOCK_DIR" ]; then
        return 0
    fi

    if [ ! -d "$BOOT_STOCK_DIR" ]; then
        log_msg "stock boot animation backup missing; leaving current boot animation"
        return 1
    fi

    remount_root_rw || {
        log_msg "could not remount root rw for stock boot animation restore"
        return 1
    }

    mkdir -p /loong/textures/boot/0 /loong/textures/boot/1 2>/dev/null || true
    rm -f /loong/textures/boot/0/* /loong/textures/boot/1/* 2>/dev/null || true
    cp "$BOOT_STOCK_DIR/0/"*.png /loong/textures/boot/0/ 2>/dev/null || true
    cp "$BOOT_STOCK_DIR/1/"*.png /loong/textures/boot/1/ 2>/dev/null || true
    if [ -f "$BOOT_STOCK_CFG" ]; then
        cp "$BOOT_STOCK_CFG" /loong/textures/boot.cfg 2>/dev/null || true
    else
        write_stock_boot_cfg_fallback || true
    fi
    chmod 755 /loong/textures/boot /loong/textures/boot/0 /loong/textures/boot/1 2>/dev/null || true
    chmod 644 /loong/textures/boot.cfg /loong/textures/boot/0/* /loong/textures/boot/1/* 2>/dev/null || true
    printf 'stock\n' >"$BOOT_MODE" 2>/dev/null || true
    rootfs_restore_ro
    log_msg "restored stock boot animation"
    return 0
}

boot_splash_disabled() {
    [ -e "$BOOT_SPLASH_DISABLED" ]
}

ensure_leaf_boot_animation() {
    [ "$PLATFORM" = "mlp1" ] || return 1
    boot_splash_disabled && {
        restore_stock_boot_animation || true
        log_msg "boot splash disabled by user setting"
        return 1
    }

    src="$PLATFORM_ROOT/boot-animation"
    [ -d "$src/0" ] || {
        log_msg "Leaf boot animation source missing: $src"
        return 1
    }

    mode="$(cat "$BOOT_MODE" 2>/dev/null || true)"
    if [ "$mode" = "leaf" ] && [ -f "$BOOT_STAMP" ]; then
        return 0
    fi

    had_stock=0
    [ -d "$BOOT_STOCK_DIR" ] && had_stock=1

    remount_root_rw || {
        log_msg "could not remount root rw for Leaf boot animation install"
        return 1
    }

    if [ "$had_stock" -eq 0 ]; then
        cp -r /loong/textures/boot "$BOOT_STOCK_DIR" 2>/dev/null || true
        [ -f /loong/textures/boot.cfg ] && cp /loong/textures/boot.cfg "$BOOT_STOCK_CFG" 2>/dev/null || true
    fi

    mkdir -p /loong/textures/boot/0 /loong/textures/boot/1 2>/dev/null || true
    rm -f /loong/textures/boot/0/* /loong/textures/boot/1/* 2>/dev/null || true
    cp "$src/0/"*.png /loong/textures/boot/0/ 2>/dev/null || true
    cp "$src/1/"*.png /loong/textures/boot/1/ 2>/dev/null || true
    [ -f "$src/boot.cfg" ] && cp "$src/boot.cfg" /loong/textures/boot.cfg 2>/dev/null || true
    chmod 755 /loong/textures/boot /loong/textures/boot/0 /loong/textures/boot/1 2>/dev/null || true
    chmod 644 /loong/textures/boot.cfg /loong/textures/boot/0/* /loong/textures/boot/1/* 2>/dev/null || true
    touch "$BOOT_STAMP" 2>/dev/null || true
    printf 'leaf\n' >"$BOOT_MODE" 2>/dev/null || true
    rootfs_restore_ro
    log_msg "installed Leaf boot animation"
    return 0
}

start_boot_transition() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    boot_splash_disabled && return 0
    [ -x /loong/loong_transition ] || return 0
    [ -f /loong/textures/boot.cfg ] || return 0
    pidof loong_transition >/dev/null 2>&1 && return 0

    param="$(cat /loong/textures/boot.cfg 2>/dev/null || true)"
    [ -n "$param" ] || return 0

    if pgrep -x weston >/dev/null 2>&1; then
        i=0
        while [ "$i" -lt 500 ]; do
            [ -e "${XDG_RUNTIME_DIR:-/var/run}/wayland-0" ] && break
            sleep .1
            i=$((i + 1))
        done
    fi

    log_msg "starting Leaf boot transition"
    (
        cd /loong 2>/dev/null || exit 127
        export LD_LIBRARY_PATH="./:${LD_LIBRARY_PATH:-}"
        export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"
        exec ./loong_transition "$param"
    ) >>"$LOG" 2>&1 &
    echo "$!" >"$BOOT_TRANSITION_PID" 2>/dev/null || true
}

stop_boot_transition() {
    pid="$(cat "$BOOT_TRANSITION_PID" 2>/dev/null || true)"
    rm -f "$BOOT_TRANSITION_PID" 2>/dev/null || true
    case "$pid" in *[!0-9]*|'') pid="" ;; esac
    [ -z "$pid" ] || stop_transition_pid "$pid"
    # An older supervisor tracked the subshell, which could leave its animation
    # orphaned. Also finish any remaining stock animation before shutdown.
    pids="$(pidof loong_transition 2>/dev/null || true)"
    [ -n "$pids" ] && {
        log_msg "stopping remaining loong_transition pids=$pids"
        for pid in $pids; do stop_transition_pid "$pid"; done
    }
}

# Hand the vibration motor back in the state stock configures for itself at boot.
# Stock's S50loong only sets the channel up when it is NOT already exported:
#
#     if [ ! -d "/sys/class/pwm/pwmchip0/pwm0" ]; then
#         echo 0 > .../export; echo 1000000 > .../period
#         echo 500000 > .../duty_cycle; echo normal > .../polarity
#     fi
#
# jawakad exports pwm0 and deliberately never unexports it, because unexporting
# latches this driver ON. So on a handoff that guard is false, stock skips its own
# setup entirely and inherits whatever Leaf left. Stock then drives the motor with
# `enable` alone -- loong_service references that one attribute and never writes
# duty_cycle or polarity again. A channel resting at duty 0 under INVERSED polarity
# is full on, so stock's first `enable 1` starts a buzz that nothing will ever stop.
#
# Writing stock's own values here makes the channel byte-identical to a clean stock
# boot whether or not S50loong's guard fires. Order is load-bearing: enable off
# first so a live buzz stops immediately, then period, because a zero period makes
# every other write on this driver fail with EINVAL.
restore_stock_rumble() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    pwm=/sys/class/pwm/pwmchip0/pwm0
    [ -d "$pwm" ] || return 0
    printf '%s' 0 >"$pwm/enable" 2>>"$LOG" || true
    if ! printf '%s' 1000000 >"$pwm/period" 2>>"$LOG"; then
        log_msg "best-effort rumble restore: period write failed; leaving channel alone"
        return 0
    fi
    printf '%s' normal >"$pwm/polarity" 2>>"$LOG" ||
        log_msg "best-effort rumble restore: polarity write failed"
    printf '%s' 500000 >"$pwm/duty_cycle" 2>>"$LOG" ||
        log_msg "best-effort rumble restore: duty_cycle write failed"
    printf '%s' 0 >"$pwm/enable" 2>>"$LOG" ||
        log_msg "best-effort rumble restore: enable write failed"
}

# Recording conversion is intentionally detached from jawakad. Wait for the
# existing Leaf helper to finish; killing an arbitrary process with an SD fd
# would destroy work owned by apps we do not supervise.
recording_converters_running() {
    for candidate in $(pgrep -f leaf-record-convert.sh 2>/dev/null); do
        if tr '\0' '\n' <"/proc/$candidate/cmdline" 2>/dev/null |
            grep -q '/.system/leaf/platforms/mlp1/bin/leaf-record-convert.sh$'; then
            return 0
        fi
    done
    return 1
}

# ── Paused shutdown ─────────────────────────────────────────────────────────
# A power transition can wait on an app that was not proven stopped (SVC-1),
# a recording conversion, or storage that will not close. Each pause retries
# by itself, a power-button tap retries now, and a 2 s hold overrides (app,
# recording) or forces (storage) once the cards at risk are held for a
# next-boot check. See umrk-workspace plans/Jawaka/shutdown-paused-retry-and-force.md.
POWER_STATE_DIR="${UMRK_POWER_STATE_DIR:-/run}"
POWER_CARDS="$POWER_STATE_DIR/umrk-power-cards"
POWER_PREARM="$POWER_STATE_DIR/umrk-power-prearm"
POWER_RETRY="$POWER_STATE_DIR/umrk-power-retry"
POWER_UPTIME="${UMRK_POWER_UPTIME:-/proc/uptime}"
POWER_MOUNTINFO="${UMRK_POWER_MOUNTINFO:-/proc/self/mountinfo}"
POWER_BY_UUID="${UMRK_BY_UUID_DIR:-/dev/disk/by-uuid}"
POWER_SUPPLY="${UMRK_POWER_SUPPLY_DIR:-/sys/class/power_supply}"
POWER_PROC="${UMRK_POWER_PROC:-/proc}"
POWER_HOLD_CS=200
# Battery percentage at which a discharging, paused shutdown overrides or forces
# by itself. Empty keeps the rule off until a measured discharge sets it.
POWER_CRITICAL_CAPACITY="${UMRK_POWER_CRITICAL_CAPACITY:-}"
POWER_SCREEN=""

power_log() {
    echo "umrk-leaf-session: $*"
}

power_uptime_cs() {
    awk '{ printf "%d\n", $1 * 100 }' "$POWER_UPTIME" 2>/dev/null
}

# Screens are separate loong_transition processes; restart only on a change.
show_power_screen() {
    [ "$POWER_SCREEN" = "$1" ] && return 0
    POWER_SCREEN="$1"
    show_storage_display "$1"
}

# Record the mounted SD cards when shutdown begins. A card whose identity is
# gone by the time a pause begins is still held from this list.
power_snapshot_cards() {
    [ -f "$POWER_CARDS" ] && return 0
    : >"$POWER_CARDS.tmp" || return 1
    for link in "$POWER_BY_UUID"/*; do
        [ -e "$link" ] || continue
        dev="$(readlink -f "$link" 2>/dev/null)"
        # Internal eMMC is mmcblk0; SD slots are the other mmcblk devices.
        case "${dev##*/}" in mmcblk0*|'') continue ;; mmcblk*) ;; *) continue ;; esac
        awk -v dev="$dev" '{ for (i = 7; i <= NF; i++) if ($i == "-") {
                if ($(i + 2) == dev) found = 1; break } }
            END { exit found ? 0 : 1 }' "$POWER_MOUNTINFO" 2>/dev/null || continue
        echo "${link##*/} $dev" >>"$POWER_CARDS.tmp"
    done
    mv -f "$POWER_CARDS.tmp" "$POWER_CARDS"
}

# UUIDs from the snapshot that are not proven closed: gone, moved, or mounted
# with a writable mount or superblock.
power_unproven_cards() {
    [ -f "$POWER_CARDS" ] || power_snapshot_cards
    while read -r uuid dev; do
        [ -n "$uuid" ] || continue
        if [ "$(readlink -f "$POWER_BY_UUID/$uuid" 2>/dev/null)" != "$dev" ]; then
            echo "$uuid"
            continue
        fi
        awk -v dev="$dev" '{ for (i = 7; i <= NF; i++) if ($i == "-") {
                if ($(i + 2) == dev && ($6 ~ /(^|,)rw(,|$)/ || $(i + 3) ~ /(^|,)rw(,|$)/))
                    rw = 1
                break } }
            END { exit rw ? 0 : 1 }' "$POWER_MOUNTINFO" 2>/dev/null && echo "$uuid"
    done <"$POWER_CARDS"
}

# Once per shutdown: hold every card at risk before override or force is offered.
power_prearm() {
    [ -f "$POWER_PREARM" ] && return 0
    cards="$(power_unproven_cards | tr '\n' ' ')"
    if [ -z "$cards" ]; then
        echo ok >"$POWER_PREARM"
    elif timeout 15 env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/ LC_ALL=C \
            "$STORAGE_REPAIR" pre-arm paused-shutdown $cards; then
        echo ok >"$POWER_PREARM"
    else
        echo failed >"$POWER_PREARM"
    fi
    power_log "pause: next-boot check for [${cards% }]: $(cat "$POWER_PREARM")"
    # Keep a copy that survives a forced power-off.
    mkdir -p "$FALLBACK_LOG_DIR" 2>/dev/null &&
        timeout 1 cp "$LOG" "$FALLBACK_LOG_DIR/umrk-power-transition.log" 2>/dev/null
    return 0
}

power_prearmed() {
    [ "$(cat "$POWER_PREARM" 2>/dev/null)" = ok ]
}

# A discharging battery at the configured cutoff: brownout is a worse forced
# shutdown than a deliberate one, so a pause gives way by itself.
battery_critical() {
    [ -n "$POWER_CRITICAL_CAPACITY" ] || return 1
    [ "$(cat "$POWER_SUPPLY/battery/status" 2>/dev/null)" = Discharging ] || return 1
    capacity="$(cat "$POWER_SUPPLY/battery/capacity" 2>/dev/null)"
    case "$capacity" in ''|*[!0-9]*) return 1 ;; esac
    [ "$capacity" -le "$POWER_CRITICAL_CAPACITY" ] || return 1
    power_log "battery critical: ${capacity}% and discharging"
}

# Open the power key once on fd 5. Jawaka, which grabs it, has exited.
power_key_open() {
    [ -n "${POWER_KEY_OPEN:-}" ] && return 0
    key="${UMRK_POWER_KEY_DEVICE:-}"
    if [ -z "$key" ]; then
        for event in /sys/class/input/event*; do
            [ "$(cat "$event/device/name" 2>/dev/null)" = "rk805 pwrkey" ] || continue
            key="/dev/input/${event##*/}"
            break
        done
    fi
    [ -n "$key" ] && [ -r "$key" ] || return 1
    exec 5<"$key" || return 1
    POWER_KEY_OPEN=1
}

# power_key_event WAIT_CS: one 24-byte input_event as "type code value", or
# failure when nothing arrives in time.
power_key_event() {
    [ "$1" -gt 0 ] || return 1
    words="$(timeout "$(($1 / 100)).$(($1 % 100 / 10))$(($1 % 10))" \
        dd bs=24 count=1 <&5 2>/dev/null | od -An -v -tu2)"
    set -- $words
    [ "$#" -ge 11 ] || return 1
    echo "$9 ${10} ${11}"
}

# power_prompt SECONDS HOLD: "tap", "hold PRESS_CS" or "timeout". With HOLD=1 a
# press still down after POWER_HOLD_CS is a hold; with HOLD=0 a long press is a
# tap on release. Only a press seen after the prompt started counts.
power_prompt() {
    if ! power_key_open; then
        sleep "$1"
        echo timeout
        return 0
    fi
    started="$(power_uptime_cs)"
    limit=$(($1 * 100))
    pressed=""
    while :; do
        now="$(power_uptime_cs)"
        if [ -n "$pressed" ]; then
            if [ "$2" = 1 ]; then
                wait_cs=$((pressed + POWER_HOLD_CS - now))
                if [ "$wait_cs" -le 0 ]; then
                    echo "hold $pressed"
                    return 0
                fi
            else
                wait_cs=500
            fi
        else
            wait_cs=$((started + limit - now))
            if [ "$wait_cs" -le 0 ]; then
                echo timeout
                return 0
            fi
        fi
        event="$(power_key_event "$wait_cs")" || continue
        case "$event" in
            "1 116 1") [ -n "$pressed" ] || pressed="$(power_uptime_cs)" ;;
            "1 116 0") if [ -n "$pressed" ]; then echo tap; return 0; fi ;;
        esac
    done
}

# What the daemon could not prove stopped: 0 all gone, 1 something remains,
# 2 cannot be checked (no record, unknown line). Nothing here signals anything.
power_incomplete_state() {
    record="$1/incomplete"
    [ -f "$record" ] || return 2
    head -n 1 "$record" | grep -q '^reason=' || return 2
    remaining=0
    items=0
    while read -r line; do
        case "$line" in
            reason=*) continue ;;
            service=*)
                items=$((items + 1))
                pgid="${line#* pgid=}"; pgid="${pgid%% *}"
                lease="${line#* lease=}"
                case "$pgid" in ''|*[!0-9]*) return 2 ;; esac
                if [ -f "$lease" ]; then
                    # A group member keeps the generation lease locked.
                    flock -n "$lease" true 2>/dev/null || remaining=1
                elif [ "$pgid" -gt 0 ]; then
                    awk -v g="$pgid" '{ sub(/^.*\) /, ""); if ($3 == g && $1 != "Z") found = 1 }
                        END { exit found ? 0 : 1 }' "$POWER_PROC"/[0-9]*/stat 2>/dev/null && remaining=1
                else
                    return 2
                fi
                ;;
            game\ pid=*)
                items=$((items + 1))
                pid="${line#game pid=}"; pid="${pid%% *}"
                start="${line#* start=}"
                case "$pid$start" in ''|*[!0-9]*) return 2 ;; esac
                stat="$(cat "$POWER_PROC/$pid/stat" 2>/dev/null)" || continue
                stat="${stat##*) }"
                set -- $stat
                [ "$1" = Z ] && continue
                [ "$start" = 0 ] || [ "${20}" = "$start" ] || continue
                remaining=1
                ;;
            *) return 2 ;;
        esac
    done <"$record"
    [ "$items" -gt 0 ] || return 2
    return "$remaining"
}

# App cause. Continue when every recorded item is gone; a hold overrides.
pause_app() {
    power_prearm
    power_log "pause: shutdown could not prove every app stopped: $(tr '\n' ' ' <"$1/incomplete" 2>/dev/null)"
    while :; do
        power_incomplete_state "$1"
        case $? in
            0) power_log "pause: every recorded app is gone; continuing"; return 0 ;;
        esac
        if battery_critical; then
            power_log "pause: overriding the app pause for the battery"
            return 0
        fi
        if power_prearmed; then
            show_power_screen paused-app
            answer="$(power_prompt 2 1)"
        else
            show_power_screen paused-no-force
            answer="$(power_prompt 2 0)"
        fi
        case "$answer" in
            hold*)
                power_prearmed || continue
                power_log "pause: user override past an unverified stop"
                return 0
                ;;
        esac
    done
}

stop_recording_converters() {
    for candidate in $(pgrep -f leaf-record-convert.sh 2>/dev/null); do
        tr '\0' '\n' <"/proc/$candidate/cmdline" 2>/dev/null |
            grep -q '/.system/leaf/platforms/mlp1/bin/leaf-record-convert.sh$' || continue
        power_log "pause: stopping recording conversion pid=$candidate"
        stop_pid "$candidate" 20
    done
}

# Recording cause. Continue when the conversion ends; a hold stops it.
pause_recording() {
    recording_converters_running || return 0
    power_prearm
    power_log "pause: waiting for a recording conversion"
    while recording_converters_running; do
        if battery_critical; then
            stop_recording_converters
            break
        fi
        if power_prearmed; then
            show_power_screen paused-recording
            answer="$(power_prompt 1 1)"
        else
            show_power_screen paused-no-force
            answer="$(power_prompt 1 0)"
        fi
        case "$answer" in
            hold*)
                power_prearmed || continue
                power_log "pause: user stopped the recording conversion"
                stop_recording_converters
                ;;
        esac
    done
    return 0
}

# Storage cause, after a failed barrier. Returns to retry the barrier; a hold
# after a failed retry, or the battery rule, forces instead and never returns.
pause_storage() {
    action="$1"
    retry_failed="$2"
    power_prearm
    if battery_critical; then
        show_power_screen forcing
        force_power_transition "$action" "$(power_uptime_cs)"
    fi
    offer_force=0
    if [ "$retry_failed" = 1 ] && power_prearmed; then
        offer_force=1
        show_power_screen paused-storage-force
    else
        show_power_screen paused-storage
    fi
    # Automatic retry after 10 s; check the ADB marker every 2 s meanwhile.
    for _ in 1 2 3 4 5; do
        if [ -f "$POWER_RETRY" ]; then
            rm -f "$POWER_RETRY"
            power_log "pause: ADB retry"
            return 0
        fi
        answer="$(power_prompt 2 "$offer_force")"
        case "$answer" in
            tap) power_log "pause: user retry"; return 0 ;;
            hold*)
                # Force exists only once it was offered.
                [ "$offer_force" = 1 ] || continue
                show_power_screen forcing
                force_power_transition "$action" "${answer#hold }"
                ;;
        esac
    done
    power_log "pause: automatic retry"
}

force_power_transition() {
    power_log "pause: forcing $1"
    exec env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/ LC_ALL=C \
        "$POWER_TRANSITION" force "$1" "$2"
}

# This is terminal for the session, including on failure. Keep the request
# intact and never enter crash recovery, respawn or stock startup. A failure
# pauses (see above); an operator can also retry via ADB after resolving the
# writer: touch /run/umrk-power-retry.
finish_power_transition() {
    power_stop_workers
    power_close_storage "$1"
}

power_stop_workers() {
    # The clean-exit sentinel is tmpfs and disappears at reboot. Retire the
    # durable crash counter now, or three quick intentional reboots disable
    # Leaf on the next boot. The final barrier makes this removal durable.
    rm -f "$CRASH_STATE" 2>/dev/null || true
    stop_boot_transition
    stop_storage_display
    stop_audio_spk_keeper
    stop_wifi_workers
    # A daemon that died without stopping its LED effects engine, here or in
    # an earlier generation, left it holding the session log on the card. It
    # only drives the LED ring, so stopping it loses nothing. First, so its
    # exit thaws any loong_light it froze.
    stop_remaining_processes_by_name jawaka-ledd
    stop_leaf_owned_loong
    stop_owned_process pulseaudio "$OWNED_PULSE_PID"
    # The daemon has already waited for its game/finalizers and service groups.
    # A surviving writer makes the normal remount fail; never mask it with
    # emergency remount, lazy unmount or a force-power deadline.
    cd / || exit 1
    LOG=/run/umrk-power-transition.log
    exec </dev/null >>"$LOG" 2>&1
    unset LD_LIBRARY_PATH LD_PRELOAD
    export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/
}

power_close_storage() {
    pause_recording
    [ -z "$POWER_SCREEN" ] || stop_storage_display
    # Installing an update can unlink this running script. Even a read-only
    # descriptor to an unlinked inode blocks ext4's read-only remount. Exec the
    # installed supervisor to close that descriptor before the final barrier.
    exec env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/ LC_ALL=C \
        /usr/bin/umrk-leaf-session power-transition "$1"
}

run_power_transition() {
    case "${1:-}" in reboot|poweroff) power_action="$1" ;; *) exit 2 ;; esac
    cd / || exit 1
    LOG=/run/umrk-power-transition.log
    exec </dev/null >>"$LOG" 2>&1
    attempts=0
    while true; do
        rootfs_env "$POWER_TRANSITION" "$power_action"
        power_log "shutdown paused: storage could not be closed"
        retry_failed=0
        [ "$attempts" -eq 0 ] || retry_failed=1
        attempts=$((attempts + 1))
        pause_storage "$power_action" "$retry_failed"
    done
}

pass_to_stock() {
    reason="$1"
    log_msg "$reason; passing boot to stock S50loong"
    stop_boot_transition
    restore_stock_boot_animation || true
    stop_audio_spk_keeper
    # Stock S50pulseaudio runs after this hook returns and starts its own
    # daemon unconditionally; that one fails while Leaf's is alive, which would
    # leave Leaf's config and its SD session-log descriptors in the stock
    # session. Nothing waits on this path, so allow up to 2 s to save state.
    stop_owned_process pulseaudio "$OWNED_PULSE_PID" 40
    stop_wifi_workers
    kill_stale_custom_launcher
    stop_leaf_owned_loong
    restore_stock_rumble
    restore_sd_noexec
    # Hand the rootfs back to stock in the state it boots with (the kernel cmdline
    # mounts it rw). restore_stock_boot_animation leaves the rootfs read-only, but
    # stock S50loong runs `#!/bin/sh -e` and does `chmod 0775 loong_daemon` before
    # launching it — on a read-only rootfs that chmod fails, errexit aborts the
    # script, loong_daemon never starts, and the device hands off to a black screen.
    remount_root_rw || log_msg "could not remount rootfs rw for stock handoff"
    return 0
}

leaf_stop() {
    log_msg "leaf stop requested"
    stop_boot_transition
    stop_audio_spk_keeper
    stop_wifi_workers
    kill_stale_custom_launcher
    stop_leaf_owned_loong
    exit 0
}

# Boot-safety for the HDMI Output feature. The stock weston (S49, MIRROR=1) can hang
# trying to bring up a plugged-in TV at boot. Before we start the UI, force weston
# single-head on the internal panel so the compositor is always sane; jawakad then
# switches to the TV per the Settings > Display > HDMI Output setting. This lives in
# the gated leaf_start path (runs only when the Leaf marker is present), so removing
# the Leaf SD leaves stock's weston behavior (mirror) exactly as shipped — nothing on
# the rootfs is modified.
ensure_panel_first_weston() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    # Only act when a cable is actually present — the hang is HDMI-specific, and a
    # cable-less boot needs no restart.
    [ "$(cat /sys/class/drm/card0-HDMI-A-1/status 2>/dev/null)" = "connected" ] || return 0
    pgrep -x weston >/dev/null 2>&1 || return 0

    log_msg "HDMI connected at boot; forcing weston single-head on the panel"
    export WESTON_DRM_SINGLE_HEAD=1
    export WESTON_DRM_PRIMARY=DSI-1
    rm -f /tmp/.weston_drm.conf 2>/dev/null || true
    /etc/init.d/S49weston restart >>"$LOG" 2>&1 || true

    # Wait for the compositor socket so the boot splash / launcher connect cleanly.
    i=0
    while [ "$i" -lt 50 ]; do
        [ -e "${XDG_RUNTIME_DIR:-/var/run}/wayland-0" ] && break
        sleep .1
        i=$((i + 1))
    done
}

leaf_start() {
    run_storage_repair_boot
    load_env_file
    refresh_paths
    recover_launcher_sd_mount
    # Rotate every boot regardless of health: carrying a session log across
    # boots is what let it grow in the first place, and the .1 copy is what a
    # bug report needs. An unhealthy log rotates the same way; if it cannot
    # even be renamed it is dropped. Rotation runs on the card path before the
    # read-only fallback, so a broken log on a writable card is healed in place
    # instead of pushing logging onto internal storage.
    if session_log_is_healthy; then
        rotate_session_log "new session"
    else
        rotate_session_log "previous log unreadable, unwritable, or oversized"
    fi
    ensure_usable_log

    if [ ! -e "$MARKER" ]; then
        log_msg "marker absent"
        storage_recovery_notice "Leaf marker absent" && return 0
        pass_to_stock "Leaf marker absent"
        return 0
    fi

    if stock_ota_present; then
        pass_to_stock "stock loong_upgrade present"
        return 0
    fi

    ensure_panel_first_weston

    if ensure_leaf_boot_animation; then
        start_boot_transition
    fi

    if adb_restore_requested && ! adb_is_pinned; then
        log_msg "ADB restore marker present; pinning ADB"
        if ! pin_adb; then
            log_msg "ADB restore failed; continuing Leaf mode without USB ADB"
        fi
    fi

    if adb_is_pinned; then
        if ! start_usb_adb; then
            log_msg "ADB startup verification failed; continuing Leaf mode"
        fi
    else
        log_msg "ADB not pinned; continuing Leaf mode without USB ADB"
    fi

    if ! remount_sd_mode exec || ! sd_is_exec; then
        storage_recovery_notice "SD exec remount failed" && return 0
        disable_marker "SD exec remount failure"
        pass_to_stock "SD exec remount failed"
        return 0
    fi
    remount_secondary_sd_exec

    if ! preflight_jawaka_bundle; then
        storage_recovery_notice "Jawaka bundle preflight failed" && return 0
        pass_to_stock "Jawaka bundle preflight failed"
        return 0
    fi

    export_leaf_env
    start_pulseaudio_if_needed
    if prepare_loong_power_handoff; then
        export UMRK_LOONG_POWER_HANDOFF_DIR="$LOONG_POWER_HANDOFF_DIR"
    else
        log_msg "loong_power low-battery handoff unavailable"
    fi
    start_owned_loong loong_power /oem/loong/record/config/loong_power.cfg "$OWNED_POWER_PID"
    log_msg "skipping loong_light; Jawaka owns LED ring in Leaf mode"
    run_platform_hooks
    kill_stale_custom_launcher

    while true; do
        # Suspend or a card-role change can detach and recreate the active
        # mount. Re-enter the live bundle before every daemon generation so the
        # wrapper never hands a stale, getcwd-less directory to Jawaka or its
        # service children.
        cd "$BUNDLE" 2>/dev/null || {
            pass_to_stock "could not cd to launcher bundle: $BUNDLE"
            return 0
        }

        if ! check_crash_loop; then
            pass_to_stock "crash-loop guard disabled Leaf marker"
            return 0
        fi
        # A daemon generation that starts against a log which went bad or
        # oversized mid-session must not hand the broken fd down again. The
        # boot rotation above already ran; this catches drift while the device
        # stays up for days.
        if ! session_log_is_healthy; then
            rotate_session_log "log unreadable, unwritable, or oversized at generation start"
        fi
        ensure_usable_log

        # A fresh private tmpfs directory is the capability and generation.
        # Old requests cannot affect a newly started daemon.
        UMRK_POWER_REQUEST_DIR="$(mktemp -d /run/umrk-power.XXXXXX)" || return 1
        chmod 700 "$UMRK_POWER_REQUEST_DIR" || return 1
        if [ -x "$POWER_TRANSITION" ]; then
            printf '1\n' >"$UMRK_POWER_REQUEST_DIR/ready"
        fi
        export UMRK_POWER_REQUEST_DIR
        log_msg "starting Leaf launcher: $BUNDLE_BIN"
        "$BUNDLE_BIN" >>"$LOG" 2>&1
        status=$?
        # Wait for actual process exit, not the earlier clean-exit marker.
        power_action="$(cat "$UMRK_POWER_REQUEST_DIR/request" 2>/dev/null)"
        case "$power_action" in
            reboot|poweroff)
                power_snapshot_cards
                if [ "$status" -eq 0 ] && [ -f "$UMRK_POWER_REQUEST_DIR/complete" ]; then
                    finish_power_transition "$power_action"
                fi
                # SVC-1: the daemon could not prove every writer stopped, or
                # exited abnormally. Pause for proof or an explicit override.
                power_stop_workers
                power_log "daemon did not complete shutdown (status=$status); request kept at $UMRK_POWER_REQUEST_DIR"
                pause_app "$UMRK_POWER_REQUEST_DIR"
                power_close_storage "$power_action"
                ;;
        esac
        rm -rf "$UMRK_POWER_REQUEST_DIR"
        unset UMRK_POWER_REQUEST_DIR
        log_msg "Leaf launcher exited status=$status"
        recover_leaf_daemon_crash

        if [ -f "$EXIT_TO_STOCK_SENTINEL" ]; then
            rm -f "$EXIT_TO_STOCK_SENTINEL"
            pass_to_stock "exit-to-stock requested"
            return 0
        fi

        sleep 1
    done
}

case "${1:-start}" in
    start|"") leaf_start; exit 0 ;;
    stop) leaf_stop ;;
    power-transition) run_power_transition "${2:-}" ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 3
        ;;
esac
