#!/bin/sh
# UMRK Leaf init-session supervisor for Miniloong Pocket 1.
#
# This script is called by /etc/init.d/S50leaf before stock S50loong. Returning
# 0 passes control back to rcS, so stock S50loong and later scripts continue.

PLATFORM="${PLATFORM:-mlp1}"
SD_MOUNT="${SDCARD_PATH:-/mnt/sdcard}"
SECONDARY_SD_MOUNT="${UMRK_SECONDARY_SDCARD_PATH:-/media/sdcard1}"
TMPDIR="${TMPDIR:-/tmp}"
RUNTIME_DIR="${UMRK_RUNTIME_PATH:-$TMPDIR/jawaka-runtime}"
PLATFORM_ROOT="${UMRK_PLATFORM_PATH:-${SYSTEM_PATH:-$SD_MOUNT/.system/leaf/platforms/$PLATFORM}}"
USERDATA_DIR="${USERDATA_PATH:-$SD_MOUNT/.userdata/$PLATFORM}"
LOG_DIR="${LOGS_PATH:-$USERDATA_DIR/logs}"
LOG="${UMRK_LAUNCHER_LOG:-$LOG_DIR/umrk-leaf-session.log}"
BUNDLE="${UMRK_LAUNCHER_PATH:-$PLATFORM_ROOT/launcher}"
ENV_FILE="${UMRK_ENV_FILE:-$BUNDLE/env.sh}"
BUNDLE_BIN="${UMRK_BIN_PATH:-$BUNDLE/bin}/loong_pangu"
INTERNAL_DATA="${UMRK_INTERNAL_DATA_PATH:-$SD_MOUNT/.umrk/$PLATFORM}"
MARKER="${UMRK_MARKER_PATH:-$PLATFORM_ROOT/enabled}"
ADB_MARKER="${UMRK_ADB_MARKER_PATH:-$INTERNAL_DATA/adb-enabled}"
BOOT_SPLASH_DISABLED="${UMRK_BOOT_SPLASH_DISABLED_PATH:-$INTERNAL_DATA/boot-splash-disabled}"
CRASH_STATE="${UMRK_CRASH_STATE:-$USERDATA_DIR/umrk-launcher-crash-state}"
CLEAN_EXIT_SENTINEL="${UMRK_CLEAN_EXIT_SENTINEL:-$TMPDIR/umrk-clean-exit}"
EXIT_TO_STOCK_SENTINEL="${UMRK_EXIT_TO_STOCK_SENTINEL:-$TMPDIR/umrk-exit-to-stock}"
CRASH_WINDOW_SECONDS=120
CRASH_THRESHOLD=3
OWNED_POWER_PID="$TMPDIR/umrk-leaf-loong_power.pid"
OWNED_PULSE_PID="$TMPDIR/umrk-leaf-pulseaudio.pid"
OWNED_LIGHT_PID="$TMPDIR/umrk-leaf-loong_light.pid"
AUDIO_SPK_KEEPER_PID="$TMPDIR/umrk-audio-spk-keeper.pid"
BOOT_TRANSITION_PID="$TMPDIR/umrk-leaf-loong_transition.pid"
BOOT_STAMP="/loong/textures/.umrk-boot-installed"
BOOT_MODE="/loong/textures/.umrk-boot-mode"
BOOT_STOCK_DIR="/loong/textures/boot.stock"
BOOT_STOCK_CFG="/loong/textures/boot.cfg.stock.umrk"
# SD repair and recovery live on internal storage and the rootfs so they work
# whatever state the cards are in.
STORAGE_REPAIR="${UMRK_STORAGE_REPAIR:-/usr/bin/umrk-storage-repair}"
POWER_TRANSITION=/usr/bin/umrk-power-transition
STORAGE_RECOVERY_ASSETS="${UMRK_STORAGE_RECOVERY_ASSETS:-/usr/share/umrk/storage-recovery}"
FALLBACK_LOG_DIR="${UMRK_FALLBACK_LOG_DIR:-/userdata/umrk/logs}"
FALLBACK_LOG_MAX_BYTES=2097152
# A session log is a per-session artifact that every child of the launcher
# inherits, so it is capped well below the FAT32 per-file ceiling and rotated
# every boot. UMRK_LOG_MAX_BYTES tunes the cap (bytes).
LOG_MAX_BYTES="${UMRK_LOG_MAX_BYTES:-8388608}"
STORAGE_DISPLAY_PID="$TMPDIR/umrk-storage-display.pid"
STORAGE_NOTICE_SECONDS="${UMRK_STORAGE_NOTICE_SECONDS:-900}"

if [ "${1:-start}" != power-transition ]; then
    [ -f /etc/profile ] && . /etc/profile
fi

log_msg() {
    log_dir="${LOG%/*}"
    if [ "$log_dir" != "$LOG" ]; then
        mkdir -p "$log_dir" 2>/dev/null || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T' 2>/dev/null || echo unknown)" "$*" >>"$LOG" 2>/dev/null || true
}

now_seconds() {
    date '+%s' 2>/dev/null || echo 0
}

# When the card holding the session log is read-only, keep supervisor messages
# and later daemon generations on internal storage. A daemon already running
# keeps its old descriptor; that output is not recovered.
ensure_writable_log() {
    log_dir="${LOG%/*}"
    [ "$log_dir" != "$LOG" ] && mkdir -p "$log_dir" 2>/dev/null
    # Probe in a subshell: ":" is a special built-in, and BusyBox ash exits the
    # whole shell when a redirection on one fails, as it does on a read-only card.
    # A real byte, because opening for append succeeds on a file whose writes
    # fail with EIO.
    if ( printf '\n' >>"$LOG" ) 2>/dev/null; then
        return 0
    fi
    fallback="$FALLBACK_LOG_DIR/umrk-leaf-session.log"
    [ "$LOG" = "$fallback" ] && return 1
    mkdir -p "$FALLBACK_LOG_DIR" 2>/dev/null || return 1
    size=0
    [ -f "$fallback" ] && size="$(wc -c <"$fallback" | tr -d ' ')"
    case "$size" in ''|*[!0-9]*) size=0 ;; esac
    if [ "$size" -gt "$FALLBACK_LOG_MAX_BYTES" ]; then
        mv -f "$fallback" "$fallback.1" 2>/dev/null || true
    fi
    ( printf '\n' >>"$fallback" ) 2>/dev/null || return 1
    old_log="$LOG"
    LOG="$fallback"
    export UMRK_LAUNCHER_LOG="$LOG"
    log_msg "session log $old_log is not writable; logging to $LOG"
}

# Healthy means the session log can take what the launcher and its children
# will send it: readable, appendable, and well under the FAT32 per-file ceiling.
# An unreadable or unwritable log is exactly the condition a reporter had to fix
# by hand (deleting umrk-leaf-session.log brought ports back on Leaf 0.11).
session_log_is_healthy() {
    [ "$LOG" = /dev/null ] && return 0
    [ -e "$LOG" ] || return 0
    [ -f "$LOG" ] || return 1
    # The last byte, not the first: reaching it walks the whole FAT cluster
    # chain, which is where a damaged log fails.
    tail -c 1 "$LOG" >/dev/null 2>&1 || return 1
    # A real byte, not a zero-length append: that succeeds without touching the
    # device and would not detect EIO.
    ( printf '\n' >>"$LOG" ) 2>/dev/null || return 1
    size="$(wc -c <"$LOG" 2>/dev/null | tr -d ' ')"
    case "$size" in ''|*[!0-9]*) size=0 ;; esac
    [ "$size" -lt "$LOG_MAX_BYTES" ]
}

# Keep exactly one previous log as .1: it is what a bug reporter needs, and
# nothing else is kept. A log that cannot even be renamed is removed -- losing
# a broken log is strictly better than a device that cannot launch games.
rotate_session_log() {
    reason="$1"
    [ "$LOG" = /dev/null ] && return 0
    if [ -e "$LOG" ]; then
        mv -f "$LOG" "$LOG.1" 2>/dev/null || rm -f "$LOG" 2>/dev/null || true
    fi
    # Subshell: ":" is a special built-in, and sh here is bash in POSIX mode,
    # which exits the whole supervisor when a redirection on one fails -- as it
    # does on a read-only card.
    ( : >"$LOG" ) 2>/dev/null || true
    log_msg "session log rotated: $reason"
}

# The launcher and every child inherit $LOG, so it must take a byte before it
# is handed down. Card first, then the internal fallback; when neither will
# hold a log, boot on without one rather than propagate a broken descriptor.
ensure_usable_log() {
    ensure_writable_log && return 0
    echo "umrk-leaf-session: no writable session log ($LOG); logging to /dev/null" \
        >/dev/console 2>/dev/null || true
    LOG=/dev/null
    export UMRK_LAUNCHER_LOG="$LOG"
}

rootfs_env() {
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/ LC_ALL=C "$@"
}

# The storage screens draw through Weston. The boot check starts right after
# S49weston, before the compositor has made its socket, and a client started
# then fails without a word: the whole check ran behind a black screen. Wait
# for the socket, bounded, while Weston is running. When it is not running at
# all there is nothing to wait for.
wait_for_compositor() {
    socket="${XDG_RUNTIME_DIR:-/var/run}/wayland-0"
    polls=0
    while [ ! -e "$socket" ] && [ "$polls" -lt "${1:-80}" ]; do
        pgrep -x weston >/dev/null 2>&1 || return 1
        sleep .1
        polls=$((polls + 1))
    done
    [ -e "$socket" ]
}

show_storage_display() {
    screen="$1"
    [ -x /loong/loong_transition ] || return 0
    [ -f "$STORAGE_RECOVERY_ASSETS/$screen/0/0.png" ] || return 0
    stop_storage_display
    wait_for_compositor 80 || true
    param="{\"dir\":\"$STORAGE_RECOVERY_ASSETS/$screen\",\"bg\":0,\"seques\":[{\"num\":1,\"interval\":1000,\"wait\":0,\"repeat\":-1}]}"
    (
        cd /loong 2>/dev/null || exit 127
        export LD_LIBRARY_PATH=./
        export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run}"
        export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"
        exec ./loong_transition "$param"
    ) >/dev/null 2>&1 &
    echo "$!" >"$STORAGE_DISPLAY_PID" 2>/dev/null || true
}

stop_storage_display() {
    pid="$(cat "$STORAGE_DISPLAY_PID" 2>/dev/null || true)"
    rm -f "$STORAGE_DISPLAY_PID" 2>/dev/null || true
    case "$pid" in *[!0-9]*|'') return 0 ;; esac
    stop_transition_pid "$pid"
}

# A zombie has already closed its files; only a live process can hold a card.
pid_running() {
    case "$(sed -n 's/^State:[[:space:]]*\(.\).*/\1/p' "/proc/$1/status" 2>/dev/null)" in
        ''|Z) return 1 ;;
    esac
    return 0
}

# Poll for exit rather than sleeping a fixed time. Every stop runs inside the
# power-button shutdown, which must finish before the PMIC's 6 s hold cut.
# stop_pid PID POLLS: SIGTERM, wait up to POLLS x 50 ms, then SIGKILL.
stop_pid() {
    kill "$1" 2>/dev/null || return 0
    polls=0
    while pid_running "$1" && [ "$polls" -lt "$2" ]; do
        sleep .05
        polls=$((polls + 1))
    done
    if pid_running "$1"; then
        kill -9 "$1" 2>/dev/null || true
    fi
    return 0
}

stop_transition_pid() {
    # Linux comm truncates this 16-character name to loong_transitio. Match the
    # executable instead, and wait for closure before remounting its log card.
    [ "$(readlink "/proc/$1/exe" 2>/dev/null)" = /loong/loong_transition ] || return 0
    stop_pid "$1" 4
    wait "$1" 2>/dev/null || true
}

# A pending repair runs here, before any card content is read or executed.
run_storage_repair_boot() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    [ -x "$STORAGE_REPAIR" ] || return 0
    mkdir -p "$FALLBACK_LOG_DIR" 2>/dev/null || true
    boot_log="$FALLBACK_LOG_DIR/umrk-storage-repair-boot.log"
    # A repair gets its own screen: it can take several minutes and needs
    # power. A runner without pending-mode prints nothing and falls back.
    pending_mode="$(rootfs_env "$STORAGE_REPAIR" pending-mode 2>/dev/null)"
    case "$pending_mode" in
        repair) show_storage_display repairing ;;
        check) show_storage_display checking ;;
        *) rootfs_env "$STORAGE_REPAIR" pending 2>/dev/null &&
               show_storage_display checking ;;
    esac
    rootfs_env "$STORAGE_REPAIR" boot >>"$boot_log" 2>&1
    repair_status=$?
    stop_storage_display
    if [ "$repair_status" -ne 0 ]; then
        # A failed protection/result transaction cannot fall through to an
        # SD writer or stock startup. Keep rootfs recovery and diagnostics.
        show_storage_display failed
        adb_is_pinned && start_usb_adb
        printf 'SD check could not finish safely; see %s\n' "$boot_log" >/dev/console
        while true; do sleep 5; done
    fi
}

# Leaf cannot start and a card is held after a failed repair. Never hand the
# boot to a stock path that ignores the hold: say what happened, keep ADB for
# the internal logs, and power off after a bounded wait.
storage_recovery_notice() {
    [ "$PLATFORM" = "mlp1" ] || return 1
    [ -x "$STORAGE_REPAIR" ] || return 1
    rootfs_env "$STORAGE_REPAIR" has-failed-hold 2>/dev/null || return 1
    log_msg "$1 while an SD card is held after a failed repair; showing recovery notice"
    show_storage_display failed
    if adb_is_pinned; then
        start_usb_adb || true
    fi
    waited=0
    while [ "$waited" -lt "$STORAGE_NOTICE_SECONDS" ]; do
        sleep 5
        waited=$((waited + 5))
    done
    log_msg "recovery notice timed out; powering off"
    finish_power_transition poweroff
}

mountpoint_is_mounted() {
    awk -v mountpoint="$1" '$2 == mountpoint { found = 1; exit } END { exit found ? 0 : 1 }' /proc/mounts 2>/dev/null
}

launcher_candidate_ready() {
    root="$1"
    [ -n "$root" ] || return 1
    [ -e "$root/.system/leaf/platforms/$PLATFORM/enabled" ] || return 1
    [ -f "$root/.system/leaf/platforms/$PLATFORM/launcher/bin/loong_pangu" ] || return 1
    return 0
}

load_env_file() {
    ENV_FILE="${UMRK_ENV_FILE:-$BUNDLE/env.sh}"
    [ -f "$ENV_FILE" ] && . "$ENV_FILE"
}

refresh_paths() {
    SD_MOUNT="${SDCARD_PATH:-$SD_MOUNT}"
    SECONDARY_SD_MOUNT="${UMRK_SECONDARY_SDCARD_PATH:-$SECONDARY_SD_MOUNT}"
    PLATFORM_ROOT="${UMRK_PLATFORM_PATH:-${SYSTEM_PATH:-$SD_MOUNT/.system/leaf/platforms/$PLATFORM}}"
    BUNDLE="${UMRK_LAUNCHER_PATH:-$PLATFORM_ROOT/launcher}"
    BUNDLE_BIN="${UMRK_BIN_PATH:-$BUNDLE/bin}/loong_pangu"
    RUNTIME_DIR="${UMRK_RUNTIME_PATH:-$TMPDIR/jawaka-runtime}"
    USERDATA_DIR="${USERDATA_PATH:-$SD_MOUNT/.userdata/$PLATFORM}"
    LOG_DIR="${LOGS_PATH:-$USERDATA_DIR/logs}"
    LOG="${UMRK_LAUNCHER_LOG:-$LOG_DIR/umrk-leaf-session.log}"
    INTERNAL_DATA="${UMRK_INTERNAL_DATA_PATH:-$SD_MOUNT/.umrk/$PLATFORM}"
    MARKER="${UMRK_MARKER_PATH:-$PLATFORM_ROOT/enabled}"
    ADB_MARKER="${UMRK_ADB_MARKER_PATH:-$INTERNAL_DATA/adb-enabled}"
    BOOT_SPLASH_DISABLED="${UMRK_BOOT_SPLASH_DISABLED_PATH:-$INTERNAL_DATA/boot-splash-disabled}"
    CRASH_STATE="${UMRK_CRASH_STATE:-$USERDATA_DIR/umrk-launcher-crash-state}"
    CLEAN_EXIT_SENTINEL="${UMRK_CLEAN_EXIT_SENTINEL:-$TMPDIR/umrk-clean-exit}"
    EXIT_TO_STOCK_SENTINEL="${UMRK_EXIT_TO_STOCK_SENTINEL:-$TMPDIR/umrk-exit-to-stock}"
}

set_active_launcher_sd() {
    active="$1"
    alternate="$2"

    export SDCARD_PATH="$active"
    export SYSTEM_PATH="$active/.system/leaf/platforms/$PLATFORM"
    export UMRK_PLATFORM_PATH="$SYSTEM_PATH"
    export UMRK_LAUNCHER_PATH="$SYSTEM_PATH/launcher"
    export UMRK_BIN_PATH="$UMRK_LAUNCHER_PATH/bin"
    export UMRK_ENV_FILE="$UMRK_LAUNCHER_PATH/env.sh"
    export UMRK_RETROARCH_BIN="$SYSTEM_PATH/bin/retroarch"
    export CORES_PATH="$SYSTEM_PATH/cores"
    export INFO_PATH="$SYSTEM_PATH/info"
    export UMRK_RETROARCH_SHADERS_DIR="$SYSTEM_PATH/shaders"
    export USERDATA_PATH="$active/.userdata/$PLATFORM"
    export SHARED_USERDATA_PATH="$active/.userdata/shared"
    export LOGS_PATH="$USERDATA_PATH/logs"
    export UMRK_INTERNAL_DATA_PATH="$active/.umrk/$PLATFORM"
    export UMRK_MARKER_PATH="$SYSTEM_PATH/enabled"
    export UMRK_ADB_MARKER_PATH="$UMRK_INTERNAL_DATA_PATH/adb-enabled"
    export UMRK_BOOT_SPLASH_DISABLED_PATH="$UMRK_INTERNAL_DATA_PATH/boot-splash-disabled"
    export UMRK_RETROARCH_USER_SHADERS_DIR="$UMRK_INTERNAL_DATA_PATH/retroarch/.config/retroarch/shaders"
    export UMRK_RETROARCH_CONFIG_DIR="$UMRK_INTERNAL_DATA_PATH/retroarch/.config/retroarch/config"
    export JAWAKA_SDCARD_ROOT="$active"
    export JAWAKA_RETROARCH_BIN="$UMRK_RETROARCH_BIN"
    export JAWAKA_RETROARCH_CORES_DIR="$CORES_PATH"
    export CAT_THEMES_DIR="$UMRK_LAUNCHER_PATH/res/themes"
    export CAT_FONTS_DIR="$UMRK_LAUNCHER_PATH/res"
    export CAT_STATUS_ASSETS_DIR="$UMRK_LAUNCHER_PATH/res/assets"
    export ROMS_PATH="$active/Roms"
    export IMAGES_PATH="$active/Images"
    export MUSIC_PATH="$active/Music"
    export VIDEO_PATH="$active/Videos"
    export RECORDINGS_PATH="$active/Recordings"
    export APPS_PATH="$active/Apps"
    export BIOS_PATH="$active/BIOS"
    export SAVES_PATH="$active/Saves"
    export STATES_PATH="$active/States"
    export CHEATS_PATH="$active/Cheats"

    configured_secondary="$alternate"
    if [ -z "$configured_secondary" ] || [ "$configured_secondary" = "$active" ]; then
        configured_secondary="$SECONDARY_SD_MOUNT"
    fi
    if [ -z "$configured_secondary" ] || [ "$configured_secondary" = "$active" ]; then
        log_msg "cannot publish distinct configured Secondary SD root"
        return 1
    fi
    export UMRK_SECONDARY_SDCARD_PATH="$configured_secondary"
    export SDCARD_PATHS="$active:$configured_secondary"
    export USERDATA_PATHS="$active/.userdata/$PLATFORM:$configured_secondary/.userdata/$PLATFORM"
    export SHARED_USERDATA_PATHS="$active/.userdata/shared:$configured_secondary/.userdata/shared"
    export ROMS_PATHS="$active/Roms:$configured_secondary/Roms"
    export IMAGES_PATHS="$active/Images:$configured_secondary/Images"
    export MUSIC_PATHS="$active/Music:$configured_secondary/Music"
    export VIDEO_PATHS="$active/Videos:$configured_secondary/Videos"
    export RECORDINGS_PATH="$active/Recordings"
    export APPS_PATHS="$active/Apps:$configured_secondary/Apps"
    export BIOS_PATHS="$active/BIOS:$configured_secondary/BIOS"
    export SAVES_PATHS="$active/Saves:$configured_secondary/Saves"
    export STATES_PATHS="$active/States:$configured_secondary/States"
    export CHEATS_PATHS="$active/Cheats:$configured_secondary/Cheats"
    export UMRK_ENV_VERSION=2

    refresh_paths
    unset JAWAKA_RESIDENT_SWITCH_MAX
    load_env_file
    refresh_paths
}

recover_launcher_sd_mount() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    launcher_candidate_ready "$SD_MOUNT" && return 0

    candidate="$SECONDARY_SD_MOUNT"
    [ -n "$candidate" ] || return 0
    [ "$candidate" != "$SD_MOUNT" ] || return 0
    mountpoint_is_mounted "$candidate" || return 0
    launcher_candidate_ready "$candidate" || return 0

    old_sd="$SD_MOUNT"
    log_msg "launcher marker/bundle not ready on $old_sd; found active launcher SD at $candidate"
    set_active_launcher_sd "$candidate" "$old_sd"
    log_msg "recovered active launcher SD: $SD_MOUNT (alternate content SD: ${UMRK_SECONDARY_SDCARD_PATH:-none})"
}

loong_upgrade_looks_valid() {
    path="$1"
    [ -s "$path" ] || return 1
    grep -q '"otaCommand"' "$path" 2>/dev/null || return 1
    grep -q '"otaFile"' "$path" 2>/dev/null || return 1
    return 0
}

stock_ota_present() {
    for root in /mnt/sdcard "$SECONDARY_SD_MOUNT"; do
        [ -n "$root" ] || continue
        loong_upgrade_looks_valid "$root/loong_upgrade" && return 0
    done
    return 1
}

adb_is_pinned() {
    [ -x /usr/bin/adbd ] || return 1
    [ -x /etc/init.d/S50usb-gadget.sh ] || return 1
    [ -f /etc/.usb_config ] || return 1
    cfg="$(cat /etc/.usb_config 2>/dev/null | tr -d '\r\n')"
    [ "$cfg" = "usb_adb_en" ] || return 1
    attrs="$(lsattr /etc/.usb_config 2>/dev/null | awk '{print $1; exit}')"
    case "$attrs" in
        *i*) return 0 ;;
        *) return 1 ;;
    esac
}

adb_restore_requested() {
    [ -e "$ADB_MARKER" ]
}

remount_root_rw() {
    mount -o remount,rw / 2>>"$LOG" && return 0
    mount -o remount,rw /dev/root / 2>>"$LOG"
}

pin_adb() {
    [ -x /usr/bin/adbd ] || return 1
    [ -x /etc/init.d/S50usb-gadget.sh ] || return 1
    [ -f /etc/.usb_config ] || return 1

    remount_root_rw || return 1
    chattr -i /etc/.usb_config >/dev/null 2>&1 || true
    printf 'usb_adb_en\n' >/etc/.usb_config || return 1
    chattr +i /etc/.usb_config || return 1
    sync
    return 0
}

option_list_has() {
    case ",$1," in
        *",$2,"*) return 0 ;;
        *) return 1 ;;
    esac
}

sd_mount_options() {
    awk -v mountpoint="$SD_MOUNT" '$2 == mountpoint { print $4; exit }' /proc/mounts 2>/dev/null
}

sd_options_for_mode() {
    mode="$1"
    opts="$(sd_mount_options)"
    [ -n "$opts" ] || return 1

    out=""
    old_ifs="$IFS"
    IFS=,
    set -- $opts
    IFS="$old_ifs"

    for opt in "$@"; do
        case "$opt" in
            exec|noexec) opt="$mode" ;;
            suid|nosuid) opt=nosuid ;;
            '') continue ;;
        esac
        option_list_has "$out" "$opt" || out="${out:+$out,}$opt"
    done

    option_list_has "$out" "$mode" || out="${out:+$out,}$mode"
    option_list_has "$out" nosuid || out="${out:+$out,}nosuid"
    printf '%s\n' "$out"
}

sd_is_noexec() {
    opts="$(sd_mount_options)"
    [ -n "$opts" ] && option_list_has "$opts" noexec
}

sd_is_exec() {
    opts="$(sd_mount_options)"
    [ -n "$opts" ] && ! option_list_has "$opts" noexec
}

remount_sd_mode() {
    mode="$1"
    opts="$(sd_options_for_mode "$mode")" || {
        log_msg "could not read $SD_MOUNT mount options"
        return 1
    }

    log_msg "remounting $SD_MOUNT with options: $opts"
    if ! mount -o "remount,$opts" "$SD_MOUNT" 2>>"$LOG"; then
        log_msg "failed to remount $SD_MOUNT with options: $opts"
        return 1
    fi

    if [ "$mode" = exec ] && ! sd_is_exec; then
        log_msg "$SD_MOUNT still mounted noexec after exec remount"
        return 1
    fi
    if [ "$mode" = noexec ] && ! sd_is_noexec; then
        log_msg "$SD_MOUNT still mounted exec after noexec remount"
        return 1
    fi
    return 0
}

restore_sd_noexec() {
    opts="$(sd_mount_options)"
    [ -n "$opts" ] || return 0
    option_list_has "$opts" noexec && return 0
    remount_sd_mode noexec || log_msg "best-effort noexec restore failed"
}

remount_secondary_sd_exec() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    mountpoint_is_mounted "$SECONDARY_SD_MOUNT" || return 0
    # A card the kernel flipped read-only, or one kept read-only after a failed
    # repair, must stay read-only.
    access=rw
    secondary_opts="$(awk -v mountpoint="$SECONDARY_SD_MOUNT" '$2 == mountpoint { print $4; exit }' /proc/mounts 2>/dev/null)"
    option_list_has "$secondary_opts" ro && access=ro
    log_msg "best-effort remounting $SECONDARY_SD_MOUNT exec ($access)"
    mount -o "remount,$access,exec,nosuid,nodev" "$SECONDARY_SD_MOUNT" 2>>"$LOG" ||
        log_msg "best-effort exec remount failed for $SECONDARY_SD_MOUNT"
}

disable_marker() {
    reason="$1"
    stamp="$(now_seconds)"
    disabled="${MARKER}.disabled.${stamp}"
    if [ -e "$MARKER" ] && mv "$MARKER" "$disabled" 2>/dev/null; then
        log_msg "$reason: disabled marker: $disabled"
    else
        rm -f "$MARKER" 2>/dev/null || true
        log_msg "$reason: removed marker"
    fi
    rm -f "$CRASH_STATE" 2>/dev/null || true
}

check_crash_loop() {
    if [ -f "$CLEAN_EXIT_SENTINEL" ]; then
        rm -f "$CLEAN_EXIT_SENTINEL"
        rm -f "$CRASH_STATE" 2>/dev/null || true
        log_msg "clean exit detected; crash counter reset"
        return 0
    fi

    now="$(now_seconds)"
    if [ "$now" -le 0 ] 2>/dev/null; then
        log_msg "crash-loop guard skipped: date seconds unavailable"
        return 0
    fi

    first="$now"
    count=0
    if [ -f "$CRASH_STATE" ]; then
        read first count <"$CRASH_STATE" 2>/dev/null || {
            first="$now"
            count=0
        }
    fi

    case "$first" in *[!0-9]*|'') first="$now" ;; esac
    case "$count" in *[!0-9]*|'') count=0 ;; esac

    age=$((now - first))
    if [ "$age" -lt 0 ] || [ "$age" -gt "$CRASH_WINDOW_SECONDS" ]; then
        first="$now"
        count=1
    else
        count=$((count + 1))
    fi

    mkdir -p "$USERDATA_DIR" 2>/dev/null || true
    printf '%s %s\n' "$first" "$count" >"$CRASH_STATE" 2>/dev/null || true

    if [ "$count" -ge "$CRASH_THRESHOLD" ]; then
        log_msg "crash-loop guard tripped count=$count window=${CRASH_WINDOW_SECONDS}s"
        disable_marker "crash-loop guard"
        return 1
    fi
    return 0
}

