#!/bin/sh
set -u

# Protect the rootfs directories hidden beneath the two MLP1 SD mounts. A
# plain path walk would inspect the mounted cards, so bind only the root
# filesystem at a temporary view and operate on the covered directories there.
# A normal bind (not rbind) intentionally excludes child mounts.

MODE="${1:-status}"
ROOT_VIEW="${UMRK_ROOT_VIEW:-/tmp/umrk-root-view.$$}"
MOUNT_STUBS="/mnt/sdcard /media/sdcard1"
root_view_mounted=0

# SIGKILL cannot be trapped and may leave this private bind until reboot. Do
# not terminate the helper forcibly; ordinary exits and handled signals unmount.

# shellcheck disable=SC2329 # invoked by trap
cleanup() {
    if [ "$root_view_mounted" -eq 1 ]; then
        umount "$ROOT_VIEW" >/dev/null 2>&1 || true
    fi
    rmdir "$ROOT_VIEW" >/dev/null 2>&1 || true
}

fail() {
    echo "umrk-mount-stubs: $*" >&2
    exit 1
}

is_immutable() {
    attrs="$(lsattr -d "$1" 2>/dev/null | awk '{print $1; exit}')"
    case "$attrs" in
        *i*) return 0 ;;
        *) return 1 ;;
    esac
}

tree_is_immutable() {
    find "$1" -xdev -exec sh -c '
        for entry do
            attrs="$(lsattr -d "$entry" 2>/dev/null | awk '\''{print $1; exit}'\'')" ||
                exit 1
            case "$attrs" in *i*) ;; *) exit 1 ;; esac
        done
    ' sh {} +
}

tree_is_mutable() {
    find "$1" -xdev -exec sh -c '
        for entry do
            attrs="$(lsattr -d "$entry" 2>/dev/null | awk '\''{print $1; exit}'\'')" ||
                exit 1
            case "$attrs" in *i*) exit 1 ;; esac
        done
    ' sh {} +
}

case "$MODE" in
    lock|unlock|status) ;;
    *) fail "usage: $0 {lock|unlock|status}" ;;
esac

command -v mount >/dev/null 2>&1 || fail "mount command missing"
command -v umount >/dev/null 2>&1 || fail "umount command missing"
command -v chattr >/dev/null 2>&1 || fail "chattr command missing"
command -v lsattr >/dev/null 2>&1 || fail "lsattr command missing"

trap cleanup EXIT HUP INT TERM
mkdir -p "$ROOT_VIEW" || fail "cannot create root view: $ROOT_VIEW"
mount --bind / "$ROOT_VIEW" || fail "cannot bind root filesystem"
root_view_mounted=1

for stub in $MOUNT_STUBS; do
    target="$ROOT_VIEW$stub"
    case "$MODE" in
        lock)
            mkdir -p "$target" || fail "cannot create rootfs stub: $stub"
            # Protect any content already stranded beneath the mount as well as
            # the mountpoint itself. -xdev prevents an unexpected nested mount
            # from broadening the operation.
            find "$target" -xdev -depth -exec chattr +i {} + ||
                fail "cannot make rootfs stub immutable: $stub"
            tree_is_immutable "$target" ||
                fail "rootfs stub tree did not become immutable: $stub"
            ;;
        unlock)
            [ -e "$target" ] || continue
            find "$target" -xdev -exec chattr -i {} + ||
                fail "cannot clear rootfs stub immutability: $stub"
            tree_is_mutable "$target" ||
                fail "rootfs stub tree remained partly immutable: $stub"
            ;;
        status)
            [ -d "$target" ] || fail "rootfs stub missing: $stub"
            if is_immutable "$target"; then
                echo "$stub immutable"
            else
                echo "$stub mutable"
                exit 1
            fi
            ;;
    esac
done

exit 0
