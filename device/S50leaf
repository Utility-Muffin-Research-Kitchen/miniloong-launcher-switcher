#!/bin/sh
### BEGIN INIT INFO
# Provides:          leaf
# Required-Start:    mountvirtfs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Leaf launcher session gate
### END INIT INFO

SESSION=/usr/bin/umrk-leaf-session
MOUNT_STUBS=/usr/bin/umrk-mount-stubs

case "${1:-start}" in
    start|"")
        [ -x "$SESSION" ] || exit 0
        if [ ! -x "$MOUNT_STUBS" ]; then
            echo "Leaf mount-stub protection missing; falling back to stock" >&2
            exit 0
        fi
        if ! "$MOUNT_STUBS" lock; then
            echo "Leaf mount-stub protection failed; falling back to stock" >&2
            exit 0
        fi
        exec "$SESSION" start
        ;;
    stop)
        [ -x "$SESSION" ] && "$SESSION" stop
        exit 0
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 3
        ;;
esac

exit 0
