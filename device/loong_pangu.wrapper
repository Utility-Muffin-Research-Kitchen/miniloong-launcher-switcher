#!/bin/sh
# UMRK_LAUNCHER_SWITCHER_WRAPPER=1

PLATFORM="${PLATFORM:-mlp1}"
SD_MOUNT="${SDCARD_PATH:-/mnt/sdcard}"
PLATFORM_ROOT="${UMRK_PLATFORM_PATH:-${SYSTEM_PATH:-$SD_MOUNT/.system/leaf/platforms/$PLATFORM}}"
BUNDLE="${UMRK_LAUNCHER_PATH:-$PLATFORM_ROOT/launcher}"
ENV_FILE="${UMRK_ENV_FILE:-$BUNDLE/env.sh}"
if [ -f "$ENV_FILE" ]; then
    . "$ENV_FILE"
fi

SD_MOUNT="${SDCARD_PATH:-$SD_MOUNT}"
PLATFORM_ROOT="${UMRK_PLATFORM_PATH:-${SYSTEM_PATH:-$SD_MOUNT/.system/leaf/platforms/$PLATFORM}}"
BUNDLE="${UMRK_LAUNCHER_PATH:-$PLATFORM_ROOT/launcher}"
BUNDLE_BIN="${UMRK_BIN_PATH:-$BUNDLE/bin}/loong_pangu"
SECONDARY_SD_MOUNT="${UMRK_SECONDARY_SDCARD_PATH:-/media/sdcard1}"
STOCK=/loong/loong_pangu.stock.umrk
STORAGE=/loong/loong_storage
STORAGE_BACKUP=/loong/loong_storage.stock.umrk
STOCK_RUN_DIR="${UMRK_STOCK_RUN_DIR:-${TMPDIR:-/tmp}/umrk-stock-pangu}"
STOCK_RUN_BIN="$STOCK_RUN_DIR/loong_pangu"
RUNTIME_DIR="${UMRK_RUNTIME_PATH:-${TMPDIR:-/tmp}/jawaka-runtime}"
USERDATA_DIR="${USERDATA_PATH:-$SD_MOUNT/.userdata/$PLATFORM}"
LOG_DIR="${LOGS_PATH:-$USERDATA_DIR/logs}"
INTERNAL_DATA="${UMRK_INTERNAL_DATA_PATH:-$SD_MOUNT/.umrk/$PLATFORM}"
LOG="${UMRK_LAUNCHER_LOG:-$LOG_DIR/umrk-launcher.log}"
MARKER="${UMRK_MARKER_PATH:-$PLATFORM_ROOT/enabled}"
CRASH_STATE="${UMRK_CRASH_STATE:-$USERDATA_DIR/umrk-launcher-crash-state}"
CLEAN_EXIT_SENTINEL="${UMRK_CLEAN_EXIT_SENTINEL:-${TMPDIR:-/tmp}/umrk-clean-exit}"
EXIT_TO_STOCK_SENTINEL="${UMRK_EXIT_TO_STOCK_SENTINEL:-${TMPDIR:-/tmp}/umrk-exit-to-stock}"
CRASH_WINDOW_SECONDS=120
CRASH_THRESHOLD=3

log_msg() {
    log_dir="${LOG%/*}"
    if [ "$log_dir" != "$LOG" ]; then
        mkdir -p "$log_dir" 2>/dev/null || true
    fi
    printf '[%s] %s\n' "$(date '+%F %T' 2>/dev/null || echo unknown)" "$*" >>"$LOG" 2>/dev/null || true
}

now_seconds() {
    date '+%s' 2>/dev/null || echo 0
}

sd_mount_options() {
    awk -v mountpoint="$SD_MOUNT" '$2 == mountpoint { print $4; exit }' /proc/mounts 2>/dev/null
}

mountpoint_is_mounted() {
    awk -v mountpoint="$1" '$2 == mountpoint { found = 1; exit } END { exit found ? 0 : 1 }' /proc/mounts 2>/dev/null
}

launcher_candidate_ready() {
    root="$1"
    [ -n "$root" ] || return 1
    [ -e "$root/.system/leaf/platforms/$PLATFORM/enabled" ] || return 1
    [ -f "$root/.system/leaf/platforms/$PLATFORM/launcher/bin/loong_pangu" ] || return 1
    return 0
}

set_active_launcher_sd() {
    active="$1"
    alternate="$2"

    export SDCARD_PATH="$active"
    export SYSTEM_PATH="$active/.system/leaf/platforms/$PLATFORM"
    export UMRK_PLATFORM_PATH="$SYSTEM_PATH"
    export UMRK_LAUNCHER_PATH="$SYSTEM_PATH/launcher"
    export UMRK_BIN_PATH="$UMRK_LAUNCHER_PATH/bin"
    export UMRK_ENV_FILE="$UMRK_LAUNCHER_PATH/env.sh"
    export USERDATA_PATH="$active/.userdata/$PLATFORM"
    export SHARED_USERDATA_PATH="$active/.userdata/shared"
    export LOGS_PATH="$USERDATA_PATH/logs"
    export UMRK_INTERNAL_DATA_PATH="$active/.umrk/$PLATFORM"
    export UMRK_MARKER_PATH="$SYSTEM_PATH/enabled"

    configured_secondary="$alternate"
    if [ -z "$configured_secondary" ] || [ "$configured_secondary" = "$active" ]; then
        configured_secondary="$SECONDARY_SD_MOUNT"
    fi
    if [ -z "$configured_secondary" ] || [ "$configured_secondary" = "$active" ]; then
        log_msg "cannot publish distinct configured Secondary SD root"
        return 1
    fi
    export UMRK_SECONDARY_SDCARD_PATH="$configured_secondary"
    export SDCARD_PATHS="$active:$configured_secondary"
    export ROMS_PATHS="$active/Roms:$configured_secondary/Roms"
    export IMAGES_PATHS="$active/Images:$configured_secondary/Images"
    export MUSIC_PATHS="$active/Music:$configured_secondary/Music"
    export VIDEO_PATHS="$active/Videos:$configured_secondary/Videos"
    export APPS_PATHS="$active/Apps:$configured_secondary/Apps"
    export BIOS_PATHS="$active/BIOS:$configured_secondary/BIOS"
    export SAVES_PATHS="$active/Saves:$configured_secondary/Saves"
    export STATES_PATHS="$active/States:$configured_secondary/States"
    export CHEATS_PATHS="$active/Cheats:$configured_secondary/Cheats"

    ENV_FILE="${UMRK_ENV_FILE:-$UMRK_LAUNCHER_PATH/env.sh}"
    if [ -f "$ENV_FILE" ]; then
        . "$ENV_FILE"
    fi

    SD_MOUNT="${SDCARD_PATH:-$active}"
    PLATFORM_ROOT="${UMRK_PLATFORM_PATH:-${SYSTEM_PATH:-$SD_MOUNT/.system/leaf/platforms/$PLATFORM}}"
    BUNDLE="${UMRK_LAUNCHER_PATH:-$PLATFORM_ROOT/launcher}"
    BUNDLE_BIN="${UMRK_BIN_PATH:-$BUNDLE/bin}/loong_pangu"
    SECONDARY_SD_MOUNT="${UMRK_SECONDARY_SDCARD_PATH:-$SECONDARY_SD_MOUNT}"
    RUNTIME_DIR="${UMRK_RUNTIME_PATH:-${TMPDIR:-/tmp}/jawaka-runtime}"
    USERDATA_DIR="${USERDATA_PATH:-$SD_MOUNT/.userdata/$PLATFORM}"
    LOG_DIR="${LOGS_PATH:-$USERDATA_DIR/logs}"
    INTERNAL_DATA="${UMRK_INTERNAL_DATA_PATH:-$SD_MOUNT/.umrk/$PLATFORM}"
    LOG="${UMRK_LAUNCHER_LOG:-$LOG_DIR/umrk-launcher.log}"
    MARKER="${UMRK_MARKER_PATH:-$PLATFORM_ROOT/enabled}"
    CRASH_STATE="${UMRK_CRASH_STATE:-$USERDATA_DIR/umrk-launcher-crash-state}"
}

recover_launcher_sd_mount() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    launcher_candidate_ready "$SD_MOUNT" && return 0

    candidate="$SECONDARY_SD_MOUNT"
    [ -n "$candidate" ] || return 0
    [ "$candidate" != "$SD_MOUNT" ] || return 0
    mountpoint_is_mounted "$candidate" || return 0
    launcher_candidate_ready "$candidate" || return 0

    old_sd="$SD_MOUNT"
    log_msg "launcher marker/bundle not ready on $old_sd; found active launcher SD at $candidate"
    set_active_launcher_sd "$candidate" "$old_sd"
    log_msg "recovered active launcher SD: $SD_MOUNT (alternate content SD: ${UMRK_SECONDARY_SDCARD_PATH:-none})"
}

option_list_has() {
    case ",$1," in
        *",$2,"*) return 0 ;;
        *) return 1 ;;
    esac
}

sd_options_for_mode() {
    mode="$1"
    opts="$(sd_mount_options)"
    if [ -z "$opts" ]; then
        return 1
    fi

    out=""
    old_ifs="$IFS"
    IFS=,
    set -- $opts
    IFS="$old_ifs"

    for opt in "$@"; do
        case "$opt" in
            exec|noexec)
                opt="$mode"
                ;;
            suid|nosuid)
                opt=nosuid
                ;;
            '')
                continue
                ;;
        esac

        if ! option_list_has "$out" "$opt"; then
            out="${out:+$out,}$opt"
        fi
    done

    if ! option_list_has "$out" "$mode"; then
        out="${out:+$out,}$mode"
    fi
    if ! option_list_has "$out" nosuid; then
        out="${out:+$out,}nosuid"
    fi

    printf '%s\n' "$out"
}

sd_is_noexec() {
    opts="$(sd_mount_options)"
    [ -n "$opts" ] && option_list_has "$opts" noexec
}

sd_is_exec() {
    opts="$(sd_mount_options)"
    [ -n "$opts" ] && ! option_list_has "$opts" noexec
}

remount_sd_mode() {
    mode="$1"
    opts="$(sd_options_for_mode "$mode")" || {
        log_msg "could not read $SD_MOUNT mount options"
        return 1
    }

    log_msg "remounting $SD_MOUNT with options: $opts"
    if ! mount -o "remount,$opts" "$SD_MOUNT" 2>>"$LOG"; then
        log_msg "failed to remount $SD_MOUNT with options: $opts"
        return 1
    fi

    if [ "$mode" = exec ] && ! sd_is_exec; then
        log_msg "$SD_MOUNT still mounted noexec after exec remount"
        return 1
    fi
    if [ "$mode" = noexec ] && ! sd_is_noexec; then
        log_msg "$SD_MOUNT still mounted exec after noexec remount"
        return 1
    fi

    return 0
}

restore_sd_noexec() {
    opts="$(sd_mount_options)"
    if [ -z "$opts" ]; then
        log_msg "$SD_MOUNT is not mounted; cannot restore noexec"
        return 0
    fi
    if option_list_has "$opts" noexec; then
        return 0
    fi
    remount_sd_mode noexec || log_msg "best-effort noexec restore failed"
}

is_umrk_noop_storage() {
    [ -f "$STORAGE" ] && grep -q "umrk-noop" "$STORAGE" 2>/dev/null
}

restore_stock_storage() {
    is_umrk_noop_storage || return 0

    if [ ! -f "$STORAGE_BACKUP" ]; then
        log_msg "loong_storage is noop but backup missing: $STORAGE_BACKUP"
        return 1
    fi

    if cp -p "$STORAGE_BACKUP" "$STORAGE" 2>/dev/null; then
        chmod 0775 "$STORAGE" 2>/dev/null || chmod 755 "$STORAGE" 2>/dev/null || true
        sync
        log_msg "restored stock loong_storage"
    else
        log_msg "failed to restore $STORAGE from $STORAGE_BACKUP"
        return 1
    fi

    if pidof loong_storage >/dev/null 2>&1; then
        killall loong_storage 2>/dev/null || true
        sleep 1
    fi
}

disable_stock_storage() {
    # Stop loong_storage from remounting the SD card read-only. The custom
    # launcher needs persistent rw access for its SQLite database, settings,
    # and saves. loong_daemon's keepStorageAlive respawns this path, so
    # atomically replace it with a no-op sleeper before killing any currently
    # mapped stock process.
    if [ -x "$STORAGE" ] && ! is_umrk_noop_storage; then
        if [ ! -f "$STORAGE_BACKUP" ]; then
            if cp -p "$STORAGE" "$STORAGE_BACKUP" 2>/dev/null; then
                log_msg "backed up loong_storage to $STORAGE_BACKUP"
            else
                log_msg "failed to back up loong_storage; leaving stock loong_storage active"
                return 1
            fi
        fi
        storage_tmp="/tmp/loong_storage.umrk-noop.$$"
        if printf '#!/bin/sh\n# umrk-noop: loong_storage disabled by launcher switcher\nwhile true; do sleep 3600; done\n' > "$storage_tmp" &&
           chmod 755 "$storage_tmp" &&
           mv -f "$storage_tmp" "$STORAGE"; then
            log_msg "replaced loong_storage with noop sleeper"
        else
            rm -f "$storage_tmp" 2>/dev/null || true
            log_msg "failed to replace loong_storage with noop sleeper"
        fi
    fi
    if pidof loong_storage >/dev/null 2>&1; then
        killall loong_storage 2>/dev/null || true
        sleep 1
    fi
}

remount_secondary_sd_exec() {
    [ "$PLATFORM" = "mlp1" ] || return 0
    mountpoint_is_mounted "$SECONDARY_SD_MOUNT" || return 0
    log_msg "best-effort remounting $SECONDARY_SD_MOUNT exec"
    if ! mount -o remount,rw,exec,nosuid,nodev "$SECONDARY_SD_MOUNT" 2>>"$LOG"; then
        log_msg "best-effort exec remount failed for $SECONDARY_SD_MOUNT"
    fi
}

disable_marker() {
    reason="$1"
    stamp="$(now_seconds)"
    disabled="${MARKER}.disabled.${stamp}"
    if [ -e "$MARKER" ] && mv "$MARKER" "$disabled" 2>/dev/null; then
        log_msg "$reason: disabled marker: $disabled"
    else
        rm -f "$MARKER" 2>/dev/null || true
        log_msg "$reason: removed marker"
    fi
    rm -f "$CRASH_STATE" 2>/dev/null || true
}

disable_marker_for_crash_loop() {
    disable_marker "crash-loop guard"
}

disable_marker_for_remount_failure() {
    disable_marker "SD exec remount failure"
}

check_crash_loop() {
    # If jawakad exited cleanly (wrote a clean-exit marker), reset the crash
    # counter and skip the guard. The marker is in /tmp so it clears on reboot.
    if [ -f "$CLEAN_EXIT_SENTINEL" ]; then
        rm -f "$CLEAN_EXIT_SENTINEL"
        rm -f "$CRASH_STATE" 2>/dev/null || true
        log_msg "clean exit detected — crash counter reset"
        return 0
    fi

    now="$(now_seconds)"
    if [ "$now" -le 0 ] 2>/dev/null; then
        log_msg "crash-loop guard skipped: date seconds unavailable"
        return 0
    fi

    first="$now"
    count=0
    if [ -f "$CRASH_STATE" ]; then
        read first count <"$CRASH_STATE" 2>/dev/null || {
            first="$now"
            count=0
        }
    fi

    case "$first" in *[!0-9]*|'') first="$now" ;; esac
    case "$count" in *[!0-9]*|'') count=0 ;; esac

    age=$((now - first))
    if [ "$age" -lt 0 ] || [ "$age" -gt "$CRASH_WINDOW_SECONDS" ]; then
        first="$now"
        count=1
    else
        count=$((count + 1))
    fi

    mkdir -p "$USERDATA_DIR" 2>/dev/null || true
    printf '%s %s\n' "$first" "$count" >"$CRASH_STATE" 2>/dev/null || true

    if [ "$count" -ge "$CRASH_THRESHOLD" ]; then
        log_msg "crash-loop guard tripped count=$count window=${CRASH_WINDOW_SECONDS}s"
        disable_marker_for_crash_loop
        exec_stock "$@"
    fi
}

exec_stock() {
    restore_sd_noexec
    restore_stock_storage || true
    kill_stale_custom_launcher

    if [ ! -x "$STOCK" ]; then
        log_msg "stock fallback missing or not executable: $STOCK"
        exit 127
    fi

    mkdir -p "$STOCK_RUN_DIR" 2>/dev/null || true
    ln -sf "$STOCK" "$STOCK_RUN_BIN" 2>/dev/null || true

    cd /loong 2>/dev/null || true
    log_msg "starting stock gui"
    if [ -x "$STOCK_RUN_BIN" ]; then
        exec "$STOCK_RUN_BIN" "$@"
    fi
    exec "$STOCK" "$@"
}

kill_stale_custom_launcher() {
    for name in jawakad jawaka-launcher jawaka-menu jawaka-osd retroarch; do
        pids="$(pidof "$name" 2>/dev/null || true)"
        if [ -n "$pids" ]; then
            log_msg "stopping stale $name pids=$pids"
            kill $pids 2>/dev/null || true
        fi
    done
    if command -v pgrep >/dev/null 2>&1; then
        pids="$(pgrep -f jawaka-retroarch-runner 2>/dev/null || true)"
        if [ -n "$pids" ]; then
            log_msg "stopping stale jawaka-retroarch-runner pids=$pids"
            kill $pids 2>/dev/null || true
        fi
    fi

    sleep 1

    for name in jawakad jawaka-launcher jawaka-menu jawaka-osd retroarch; do
        pids="$(pidof "$name" 2>/dev/null || true)"
        if [ -n "$pids" ]; then
            log_msg "force stopping stale $name pids=$pids"
            kill -9 $pids 2>/dev/null || true
        fi
    done
    if command -v pgrep >/dev/null 2>&1; then
        pids="$(pgrep -f jawaka-retroarch-runner 2>/dev/null || true)"
        if [ -n "$pids" ]; then
            log_msg "force stopping stale jawaka-retroarch-runner pids=$pids"
            kill -9 $pids 2>/dev/null || true
        fi
    fi
}

preflight_jawaka_bundle() {
    for bin in "$BUNDLE_BIN" "$BUNDLE/bin/jawaka-launcher" "$BUNDLE/bin/jawaka-menu"; do
        if [ ! -f "$bin" ]; then
            log_msg "marker present but launcher executable missing: $bin"
            return 1
        fi
        if [ ! -x "$bin" ]; then
            log_msg "marker present but launcher executable is not executable: $bin"
            return 1
        fi
    done

    if [ ! -f "$BUNDLE/res/font.ttf" ]; then
        log_msg "marker present but launcher font missing: $BUNDLE/res/font.ttf"
        return 1
    fi
    if [ ! -d "$BUNDLE/res/themes" ]; then
        log_msg "marker present but launcher themes missing: $BUNDLE/res/themes"
        return 1
    fi
    if [ ! -d "$BUNDLE/res/assets" ]; then
        log_msg "marker present but launcher status assets missing: $BUNDLE/res/assets"
        return 1
    fi

    mkdir -p "$RUNTIME_DIR" "$USERDATA_DIR" "$LOG_DIR" "$INTERNAL_DATA" 2>/dev/null || {
        log_msg "failed to create runtime directory: $RUNTIME_DIR"
        return 1
    }

    return 0
}

recover_launcher_sd_mount

if [ ! -e "$MARKER" ]; then
    log_msg "marker absent, using stock gui"
    rm -f "$CRASH_STATE" 2>/dev/null || true
    exec_stock "$@"
fi

# EXIT-TO-STOCK: temporary dev/test feature. Jawakad writes this sentinel
# on intentional "Exit to Stock" from the menu. Falls back to stock for this
# session only — sentinel lives in /tmp so it is cleared on reboot. See
# jawakad shutdown handler and jawaka-menu EXIT_STOCK case. May be removed.
if [ -f "$EXIT_TO_STOCK_SENTINEL" ]; then
    rm -f "$EXIT_TO_STOCK_SENTINEL"
    log_msg "exit-to-stock requested — using stock gui (this session only)"
    rm -f "$CRASH_STATE" 2>/dev/null || true
    exec_stock "$@"
fi

check_crash_loop "$@"

if [ ! -f "$BUNDLE_BIN" ]; then
    log_msg "marker present but launcher binary missing: $BUNDLE_BIN"
    exec_stock "$@"
fi

if ! remount_sd_mode exec; then
    disable_marker_for_remount_failure
    exec_stock "$@"
fi

if ! sd_is_exec; then
    log_msg "$SD_MOUNT is noexec after remount verification"
    disable_marker_for_remount_failure
    exec_stock "$@"
fi

remount_secondary_sd_exec

if ! preflight_jawaka_bundle; then
    exec_stock "$@"
fi

disable_stock_storage

# Run platform boot scripts from the SD card hook directory. Each executable
# file in platform.d/ is sourced in sorted order before the launcher starts.
if [ -d "$PLATFORM_ROOT/platform.d" ]; then
    for script in "$PLATFORM_ROOT/platform.d"/*.sh; do
        [ -f "$script" ] && [ -x "$script" ] || continue
        log_msg "running platform script: $script"
        "$script" >>"$LOG" 2>&1 || log_msg "platform script failed: $script"
    done
fi

killall loong_transition 2>/dev/null || true
log_msg "dismissed stock boot transition"
# Note: loong_service respawns loong_transition within ~2s until the home
# launcher signals readiness. jawaka-launcher does that by calling the loong
# SDK's EventOpend("HOME") after its first frame (see jw_loong_notify_home_ready
# in Jawaka), which makes loong_service stop showing/respawning the splash. The
# killall above only shortens the initial flash.
kill_stale_custom_launcher
log_msg "cleared stale custom launcher processes"

export PLATFORM="${PLATFORM:-mlp1}"
export DEVICE="${DEVICE:-$PLATFORM}"
export SDCARD_PATH="${SDCARD_PATH:-$SD_MOUNT}"
export SYSTEM_PATH="${SYSTEM_PATH:-$PLATFORM_ROOT}"
export UMRK_PLATFORM_PATH="${UMRK_PLATFORM_PATH:-$PLATFORM_ROOT}"
export UMRK_LAUNCHER_PATH="${UMRK_LAUNCHER_PATH:-$BUNDLE}"
export UMRK_BIN_PATH="${UMRK_BIN_PATH:-$BUNDLE/bin}"
export UMRK_ENV_FILE="${UMRK_ENV_FILE:-$BUNDLE/env.sh}"
export UMRK_RUNTIME_PATH="${UMRK_RUNTIME_PATH:-$RUNTIME_DIR}"
export UMRK_RETROARCH_BIN="${UMRK_RETROARCH_BIN:-$PLATFORM_ROOT/bin/retroarch}"
export USERDATA_PATH="${USERDATA_PATH:-$USERDATA_DIR}"
export SHARED_USERDATA_PATH="${SHARED_USERDATA_PATH:-$SD_MOUNT/.userdata/shared}"
export LOGS_PATH="${LOGS_PATH:-$LOG_DIR}"
export UMRK_INTERNAL_DATA_PATH="${UMRK_INTERNAL_DATA_PATH:-$INTERNAL_DATA}"
export ROMS_PATH="${ROMS_PATH:-$SD_MOUNT/Roms}"
export IMAGES_PATH="${IMAGES_PATH:-$SD_MOUNT/Images}"
export MUSIC_PATH="${MUSIC_PATH:-$SD_MOUNT/Music}"
export VIDEO_PATH="${VIDEO_PATH:-$SD_MOUNT/Videos}"
export APPS_PATH="${APPS_PATH:-$SD_MOUNT/Apps}"
export BIOS_PATH="${BIOS_PATH:-$SD_MOUNT/BIOS}"
export SAVES_PATH="${SAVES_PATH:-$SD_MOUNT/Saves}"
export STATES_PATH="${STATES_PATH:-$SD_MOUNT/States}"
export CHEATS_PATH="${CHEATS_PATH:-$SD_MOUNT/Cheats}"
export CORES_PATH="${CORES_PATH:-$PLATFORM_ROOT/cores}"
export INFO_PATH="${INFO_PATH:-$PLATFORM_ROOT/info}"
export UMRK_RETROARCH_SHADERS_DIR="${UMRK_RETROARCH_SHADERS_DIR:-$PLATFORM_ROOT/shaders}"
export UMRK_RETROARCH_USER_SHADERS_DIR="${UMRK_RETROARCH_USER_SHADERS_DIR:-$UMRK_INTERNAL_DATA_PATH/retroarch/.config/retroarch/shaders}"
export UMRK_SECONDARY_SDCARD_PATH="${UMRK_SECONDARY_SDCARD_PATH:-$SECONDARY_SD_MOUNT}"
if [ "$PLATFORM" = "mlp1" ]; then
    export SDCARD_PATHS="${SDCARD_PATHS:-$SDCARD_PATH:$UMRK_SECONDARY_SDCARD_PATH}"
    export ROMS_PATHS="${ROMS_PATHS:-$ROMS_PATH:$UMRK_SECONDARY_SDCARD_PATH/Roms}"
    export IMAGES_PATHS="${IMAGES_PATHS:-$IMAGES_PATH:$UMRK_SECONDARY_SDCARD_PATH/Images}"
    export MUSIC_PATHS="${MUSIC_PATHS:-$MUSIC_PATH:$UMRK_SECONDARY_SDCARD_PATH/Music}"
    export VIDEO_PATHS="${VIDEO_PATHS:-$VIDEO_PATH:$UMRK_SECONDARY_SDCARD_PATH/Videos}"
    export APPS_PATHS="${APPS_PATHS:-$APPS_PATH:$UMRK_SECONDARY_SDCARD_PATH/Apps}"
    export BIOS_PATHS="${BIOS_PATHS:-$BIOS_PATH:$UMRK_SECONDARY_SDCARD_PATH/BIOS}"
    export SAVES_PATHS="${SAVES_PATHS:-$SAVES_PATH:$UMRK_SECONDARY_SDCARD_PATH/Saves}"
    export STATES_PATHS="${STATES_PATHS:-$STATES_PATH:$UMRK_SECONDARY_SDCARD_PATH/States}"
    export CHEATS_PATHS="${CHEATS_PATHS:-$CHEATS_PATH:$UMRK_SECONDARY_SDCARD_PATH/Cheats}"
else
    export SDCARD_PATHS="${SDCARD_PATHS:-$SDCARD_PATH}"
    export ROMS_PATHS="${ROMS_PATHS:-$ROMS_PATH}"
    export IMAGES_PATHS="${IMAGES_PATHS:-$IMAGES_PATH}"
    export MUSIC_PATHS="${MUSIC_PATHS:-$MUSIC_PATH}"
    export VIDEO_PATHS="${VIDEO_PATHS:-$VIDEO_PATH}"
    export APPS_PATHS="${APPS_PATHS:-$APPS_PATH}"
    export BIOS_PATHS="${BIOS_PATHS:-$BIOS_PATH}"
    export SAVES_PATHS="${SAVES_PATHS:-$SAVES_PATH}"
    export STATES_PATHS="${STATES_PATHS:-$STATES_PATH}"
    export CHEATS_PATHS="${CHEATS_PATHS:-$CHEATS_PATH}"
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS="${SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS:-1}"
export CAT_WINDOW_WIDTH="${CAT_WINDOW_WIDTH:-960}"
export CAT_WINDOW_HEIGHT="${CAT_WINDOW_HEIGHT:-720}"
export CAT_THEMES_DIR="${CAT_THEMES_DIR:-$BUNDLE/res/themes}"
export CAT_FONTS_DIR="${CAT_FONTS_DIR:-$BUNDLE/res}"
export CAT_STATUS_ASSETS_DIR="${CAT_STATUS_ASSETS_DIR:-$BUNDLE/res/assets}"
export JAWAKA_RUNTIME_DIR="${JAWAKA_RUNTIME_DIR:-$RUNTIME_DIR}"
export JAWAKA_SDCARD_ROOT="${JAWAKA_SDCARD_ROOT:-$SD_MOUNT}"
export JAWAKA_RETROARCH_BIN="${JAWAKA_RETROARCH_BIN:-$UMRK_RETROARCH_BIN}"
export JAWAKA_RETROARCH_CORES_DIR="${JAWAKA_RETROARCH_CORES_DIR:-$CORES_PATH}"
export JAWAKA_THEME="${JAWAKA_THEME:-Jawaka-Tabs}"
if [ -d "$BUNDLE/lib" ]; then
    export LD_LIBRARY_PATH="$BUNDLE/lib:${LD_LIBRARY_PATH:-}"
fi

cd "$BUNDLE" 2>/dev/null || {
    log_msg "could not cd to launcher bundle: $BUNDLE"
    exec_stock "$@"
}

log_msg "starting custom launcher directly from SD: $BUNDLE_BIN"
exec >>"$LOG" 2>&1
exec "$BUNDLE_BIN" "$@"

log_msg "custom launcher exec failed: $BUNDLE_BIN"
exec_stock "$@"
